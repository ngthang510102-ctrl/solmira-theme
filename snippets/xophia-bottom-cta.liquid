{%- comment -%}
  Khung chốt đơn cuối trang (Bottom CTA). Dùng cho mọi sản phẩm. Chỉ chạy ở mẫu product.kinh.
  Dùng trong Custom Liquid: {% render 'xophia-bottom-cta' %}  (đặt sau xo_howto, trước xo_footer)
  Cách hoạt động khi bấm nút:
    - Sản phẩm chỉ có 1 biến thể: mở thẳng form COD (bấm #cod-open).
    - Sản phẩm có nhiều biến thể/gói/màu: cuộn mượt lên khối chọn gói/màu để khách chọn trước khi đặt.
  Chữ chỉ dùng thông tin đúng với chính sách cửa hàng. Không số liệu bịa.
{%- endcomment -%}
{% if template.suffix == 'kinh' and product != blank %}
<style>
  .xo-cta {
    background: #fdfbf7;
    padding: 28px 16px;
  }
  .xo-cta__inner {
    max-width: 760px;
    margin: 0 auto;
    padding: 28px 20px;
    border-radius: 22px;
    background: #6b2429;
    background-image: linear-gradient(180deg, #772a30 0%, #5f1f24 100%);
    color: #FBEFE0;
    text-align: center;
    box-shadow: 0 12px 28px rgba(107, 36, 41, .28);
  }
  .xo-cta .xo-cta__title {
    margin: 0 0 8px;
    color: #FBEFE0;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.25;
  }
  .xo-cta .xo-cta__sub {
    margin: 0 0 20px;
    color: #E8C98A;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: .02em;
  }
  .xo-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    max-width: 420px;
    min-height: 58px;
    padding: 14px 24px;
    border: 0;
    border-radius: 999px;
    background: #D9480F;
    color: #FFFFFF;
    font: inherit;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: .04em;
    cursor: pointer;
    box-shadow: 0 8px 18px rgba(0, 0, 0, .28);
    transition: transform .15s ease, background .2s ease;
  }
  .xo-cta__btn:hover { background: #BF3F0B; transform: translateY(-1px); }
  .xo-cta__btn:focus-visible { outline: 3px solid #E8C98A; outline-offset: 3px; }
  .xo-cta__btn svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .xo-cta .xo-cta__note {
    margin: 14px 0 0;
    color: rgba(251, 239, 224, .85);
    font-size: 13px;
  }
  @media (min-width: 750px) {
    .xo-cta { padding: 44px 24px; }
    .xo-cta__inner { padding: 44px 32px; }
    .xo-cta .xo-cta__title { font-size: 32px; }
  }
</style>

<section class="xo-cta" aria-labelledby="xo-cta-title">
  <div class="xo-cta__inner">
    <h2 class="xo-cta__title" id="xo-cta-title">¿Listo para hacer tu pedido?</h2>
    <p class="xo-cta__sub">Pago contra reembolso · Sin tarjeta · Envío gratis</p>
    <button type="button" class="xo-cta__btn" data-xo-cta data-variants="{{ product.variants.size }}">
      <span>COMPRAR AHORA</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </button>
    <p class="xo-cta__note">Pagas en efectivo al repartidor cuando recibes tu pedido.</p>
  </div>
</section>

<script>
(function () {
  var btn = document.querySelector('[data-xo-cta]');
  if (!btn || btn.dataset.ready) return;
  btn.dataset.ready = '1';
  btn.addEventListener('click', function () {
    var open = document.getElementById('cod-open');
    var multiple = Number(btn.dataset.variants) > 1;
    var smooth = !(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
    if (!multiple && open && !open.disabled) {
      open.click();
      return;
    }
    var target = document.querySelector('pack-picker') ||
                 document.querySelector('variant-selects') ||
                 open;
    if (target) {
      target.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'center' });
    }
  });
})();
</script>
{% endif %}