{%- comment -%}
  Cómo hacer tu pedido (pago contra reembolso) - timeline 3 bước. Dùng được cho mọi sản phẩm.
  Dọc trên mobile, ngang trên desktop. Có icon SVG.
  Dùng trong Custom Liquid: {% render 'xophia-wo-howto' %}
  Mobile-first, chỉ HTML/CSS + SVG nội tuyến. Màu: navy #6B2D45, nền kem #FBF3EF, chữ #2A1B22.
{%- endcomment -%}
{% if template.suffix == 'kinh-wo' %}
<style>
  .xo-howto {
    --xo-primary: #6B2D45;
    --xo-gold: #E2BD94;
    --xo-cream: #FBF3EF;
    --xo-ink: #2A1B22;
    --xo-muted: #6B5A62;
    background: var(--xo-cream);
    color: var(--xo-ink);
    padding: 40px 16px 36px;
  }
  .xo-howto__inner { max-width: 980px; margin: 0 auto; }
  .xo-howto .xo-howto__title {
    margin: 0 auto 26px;
    max-width: 560px;
    text-align: center;
    color: var(--xo-ink);
    font-size: 22px;
    font-weight: 700;
    line-height: 1.3;
  }
  .xo-howto .xo-howto__title::after {
    content: "";
    display: block;
    width: 56px;
    height: 3px;
    margin: 14px auto 0;
    border-radius: 3px;
    background: var(--xo-primary);
  }

  .xo-howto__steps { display: grid; gap: 22px; margin: 0; padding: 0; list-style: none; }
  .xo-howto__step { position: relative; display: flex; align-items: flex-start; gap: 14px; margin: 0; padding: 0; }
  .xo-howto__step:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 25px;
    top: 56px;
    bottom: -20px;
    border-left: 2px dotted rgba(107, 45, 69, .35);
  }
  .xo-howto__bubble {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--xo-primary);
    color: var(--xo-gold);
    box-shadow: 0 0 0 4px var(--xo-cream), 0 4px 10px rgba(107, 45, 69, .25);
  }
  .xo-howto__bubble svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .xo-howto__body {
    flex: 1;
    min-width: 0;
    padding: 12px 14px;
    background: #fff;
    border: 1px solid rgba(107, 45, 69, .12);
    border-radius: 16px;
    box-shadow: 0 4px 14px rgba(107, 45, 69, .07);
  }
  .xo-howto .xo-howto__h3 { margin: 0 0 4px; color: var(--xo-ink); font-size: 15.5px; font-weight: 700; line-height: 1.3; }
  .xo-howto .xo-howto__text { margin: 0; color: var(--xo-muted); font-size: 14px; line-height: 1.55; }

  @media (min-width: 750px) {
    .xo-howto { padding: 56px 24px 50px; }
    .xo-howto .xo-howto__title { font-size: 30px; margin-bottom: 38px; max-width: none; }
    .xo-howto__steps { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
    .xo-howto__step { flex-direction: column; align-items: center; text-align: center; gap: 16px; }
    .xo-howto__step:not(:last-child)::after {
      left: calc(50% + 40px);
      right: calc(-50% - 24px + 40px);
      top: 27px;
      bottom: auto;
      border-left: 0;
      border-top: 2px dotted rgba(107, 45, 69, .35);
    }
    .xo-howto__bubble { width: 56px; height: 56px; }
    .xo-howto__body { width: 100%; padding: 18px 16px; }
    .xo-howto .xo-howto__h3 { font-size: 16.5px; }
  }
</style>

<section class="xo-howto" aria-labelledby="xo-howto-title">
  <div class="xo-howto__inner">

    <h2 class="xo-howto__title" id="xo-howto-title">Cómo hacer tu pedido (pago contra reembolso)</h2>

    <ol class="xo-howto__steps">

      <li class="xo-howto__step">
        <span class="xo-howto__bubble">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="9" cy="20" r="1.4"/>
            <circle cx="17" cy="20" r="1.4"/>
            <path d="M3 4h2.5l2.2 11h10l1.8-8H7"/>
          </svg>
        </span>
        <div class="xo-howto__body">
          <h3 class="xo-howto__h3">1. Haz tu pedido hoy</h3>
          <p class="xo-howto__text">Elige tu opción y la cantidad que prefieras y rellena tus datos de envío en 1 minuto.</p>
        </div>
      </li>

      <li class="xo-howto__step">
        <span class="xo-howto__bubble">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21 12a8 8 0 0 1-11.7 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/>
            <path d="M9 11.5h6M9 14.5h4"/>
          </svg>
        </span>
        <div class="xo-howto__body">
          <h3 class="xo-howto__h3">2. Confirmación por WhatsApp</h3>
          <p class="xo-howto__text">Te escribiremos por WhatsApp para confirmar tu dirección de entrega.</p>
        </div>
      </li>

      <li class="xo-howto__step">
        <span class="xo-howto__bubble">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="6" width="18" height="12" rx="2"/>
            <circle cx="12" cy="12" r="2.5"/>
            <path d="M6.5 9.5v.01M17.5 14.5v.01"/>
          </svg>
        </span>
        <div class="xo-howto__body">
          <h3 class="xo-howto__h3">3. Paga en efectivo al repartidor</h3>
          <p class="xo-howto__text">Comprueba que tu pedido está correcto al recibirlo y paga el importe exacto al repartidor.</p>
        </div>
      </li>

    </ol>

  </div>
</section>
{% endif %}