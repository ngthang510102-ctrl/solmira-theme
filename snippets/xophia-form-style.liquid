{%- comment -%}
  Giao diện FORM ĐẶT HÀNG (popup cod-form) đồng bộ với trang + dọn khoảng trắng khối đánh giá (custom_liquid_UccTmV). CHỈ Ở MẪU product.kinh. Chỉ CSS.
  Màu: navy #1e3a5f, kem #fdfbf7, nút cam #D9480F (giống nút COMPRAR AHORA). Nút CONFIRMAR PEDIDO được đổi màu trong xophia-theme-colors.
  Để tắt: xoá dòng render 'xophia-form-style' trong xophia-assurance.
{%- endcomment -%}
{% if template.suffix == 'kinh' %}
<style>
  cod-form .cod-dialog__header h2, cod-form .cod-dialog__header [class*=title] { color: #1a1a1a; }
  cod-form .cod-summary { background: #fdfbf7; border: 1px solid rgba(30, 58, 95, .18); border-radius: 12px; }
  cod-form .cod-totals__total { color: #1e3a5f; }
  cod-form .cod-ship__option { border: 1px solid rgba(30, 58, 95, .3); border-radius: 12px; background: #fdfbf7; }
  cod-form .cod-ship__radio, cod-form .cod-consent input { accent-color: #1e3a5f; }
  cod-form .cod-shipnote { border-radius: 12px; }

  /* Nhãn nằm trên ô nhập, ô nhập rộng hết chiều ngang */
  cod-form .cod-field { display: block !important; margin: 0 0 14px; }
  cod-form .cod-field > label { display: block; margin: 0 0 6px; color: #1a1a1a; font-size: 13px; font-weight: 700; line-height: 1.3; }
  cod-form .cod-input { width: 100%; min-height: 48px; border: 1px solid rgba(30, 58, 95, .3); border-radius: 10px; background: #fff; overflow: hidden; }
  cod-form .cod-input:focus-within { border-color: #1e3a5f; box-shadow: 0 0 0 3px rgba(30, 58, 95, .14); }
  cod-form .cod-input__icon { background: #fdfbf7; color: #1e3a5f; border-right: 1px solid rgba(30, 58, 95, .15); }
  cod-form .cod-input input, cod-form .cod-input textarea { border: 0; outline: 0; background: transparent; box-shadow: none; }
  cod-form .cod-field select { width: 100%; min-height: 48px; border: 1px solid rgba(30, 58, 95, .3); border-radius: 10px; background-color: #fff; color: #1a1a1a; }
  cod-form .cod-field select:focus { border-color: #1e3a5f; outline: 0; box-shadow: 0 0 0 3px rgba(30, 58, 95, .14); }

  /* Nút xác nhận: cam, bo góc đồng bộ ô nhập */
  cod-form .cod-submit { border: 0; border-radius: 10px; letter-spacing: .5px; box-shadow: 0 6px 16px rgba(217, 72, 15, .3); }
  cod-form .xo-form-extra, cod-form .xo-qty__box, cod-form .xo-form-variant { border-radius: 10px; }
  cod-form .xo-form-extra { border-radius: 12px; }

  /* Khối đánh giá (custom_liquid_UccTmV): bỏ dải trắng trên/dưới, cùng màu kem, ẩn thanh cuộn ngang */
  [id*="custom_liquid_UccTmV"] { background: #fdfbf7; }
  [id*="custom_liquid_UccTmV"] [class*="section-template"],
  [id*="custom_liquid_UccTmV"] .section { padding-top: 0 !important; padding-bottom: 0 !important; margin: 0 !important; }
  #jfease-reviews-2026 { background: #fdfbf7 !important; --jfr-burgundy: #1e3a5f !important; }
  #jfease-reviews-2026 .jfr-window { scrollbar-width: none; }
  #jfease-reviews-2026 .jfr-window::-webkit-scrollbar { display: none; }
</style>
{% endif %}