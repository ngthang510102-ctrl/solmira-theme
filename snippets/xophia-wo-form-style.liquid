{%- comment -%}
  Giao diện FORM ĐẶT HÀNG (popup cod-form) đồng bộ với trang + dọn khoảng trắng khối đánh giá (custom_liquid_UccTmV). CHỈ Ở MẪU product.kinh. Chỉ CSS.
  Màu: navy #6B2D45, kem #FBF3EF, nút cam #A8325A (giống nút COMPRAR AHORA). Nút CONFIRMAR PEDIDO được đổi màu trong xophia-theme-colors.
  Để tắt: xoá dòng render 'xophia-wo-form-style' trong xophia-assurance.
{%- endcomment -%}
{% if template.suffix == 'kinh-wo' %}
<style>
  cod-form .cod-dialog__header h2, cod-form .cod-dialog__header [class*=title] { color: #2A1B22; }
  cod-form .cod-summary { background: #FBF3EF; border: 1px solid rgba(107, 45, 69, .18); border-radius: 12px; }
  cod-form .cod-totals__total { color: #6B2D45; }
  cod-form .cod-ship__option { border: 1px solid rgba(107, 45, 69, .3); border-radius: 12px; background: #FBF3EF; }
  cod-form .cod-ship__radio, cod-form .cod-consent input { accent-color: #6B2D45; }
  cod-form .cod-shipnote { border-radius: 12px; }

  /* Nhãn nằm trên ô nhập, ô nhập rộng hết chiều ngang */
  cod-form .cod-field { display: block !important; margin: 0 0 14px; }
  cod-form .cod-field > label { display: block; margin: 0 0 6px; color: #2A1B22; font-size: 13px; font-weight: 700; line-height: 1.3; }
  cod-form .cod-input { width: 100%; min-height: 48px; border: 1px solid rgba(107, 45, 69, .3); border-radius: 10px; background: #fff; overflow: hidden; }
  cod-form .cod-input:focus-within { border-color: #6B2D45; box-shadow: 0 0 0 3px rgba(107, 45, 69, .14); }
  cod-form .cod-input__icon { background: #FBF3EF; color: #6B2D45; border-right: 1px solid rgba(107, 45, 69, .15); }
  cod-form .cod-input input, cod-form .cod-input textarea { border: 0; outline: 0; background: transparent; box-shadow: none; }
  cod-form .cod-field select { width: 100%; min-height: 48px; border: 1px solid rgba(107, 45, 69, .3); border-radius: 10px; background-color: #fff; color: #2A1B22; }
  cod-form .cod-field select:focus { border-color: #6B2D45; outline: 0; box-shadow: 0 0 0 3px rgba(107, 45, 69, .14); }

  /* Nút xác nhận: cam, bo góc đồng bộ ô nhập */
  cod-form .cod-submit { border: 0; border-radius: 10px; letter-spacing: .5px; box-shadow: 0 6px 16px rgba(168, 50, 90, .3); }
  cod-form .xo-form-extra, cod-form .xo-qty__box, cod-form .xo-form-variant { border-radius: 10px; }
  cod-form .xo-form-extra { border-radius: 12px; }

  /* Khối đánh giá (custom_liquid_UccTmV): bỏ dải trắng trên/dưới, cùng màu kem, ẩn thanh cuộn ngang */
  [id*="custom_liquid_UccTmV"] { background: #FBF3EF; }
  [id*="custom_liquid_UccTmV"] [class*="section-template"],
  [id*="custom_liquid_UccTmV"] .section { padding-top: 0 !important; padding-bottom: 0 !important; margin: 0 !important; }
  #jfease-reviews-2026 { background: #FBF3EF !important; --jfr-burgundy: #6B2D45 !important; }
  #jfease-reviews-2026 .jfr-window { scrollbar-width: none; }
  #jfease-reviews-2026 .jfr-window::-webkit-scrollbar { display: none; }
</style>
{% endif %}