{%- comment -%}
  KHỐI LỢI ÍCH (3 thẻ có icon SVG), TỰ ĐỘNG theo từng sản phẩm. Dùng cho mọi sản phẩm.
  Dùng trong Custom Liquid: {% render 'xophia-wo-benefits' %}   Chỉ chạy ở mẫu product.kinh.
  Lấy tối đa 3 mục <li> trong mô tả sản phẩm (chữ đậm làm tiêu đề thẻ, phần còn lại làm nội dung).
  Nếu có ít hơn 2 mục <li>: ẨN luôn khối (không còn 3 thẻ cam kết chung vì đã có ở thanh đầu trang và accordion, tránh lặp).
  Màu: navy #6B2D45, nền kem #FBF3EF, chữ #2A1B22.
{%- endcomment -%}
{% if template.suffix == 'kinh-wo' and product != blank %}

{%- assign xo_parts = product.description | split: '<li' -%}
{%- assign xo_cards = '' -%}
{%- assign xo_count = 0 -%}
{%- for part in xo_parts offset: 1 -%}
  {%- if xo_count >= 3 -%}{%- break -%}{%- endif -%}
  {%- assign xo_inner = part | split: '</li>' | first -%}
  {%- if xo_inner contains '<strong>' -%}
    {%- assign xo_title = xo_inner | split: '</strong>' | first | split: '<strong>' | last | strip_html | strip | replace: ':', '' | strip -%}
    {%- assign xo_body = xo_inner | split: '</strong>' | slice: 1 | join: '' | strip_html | strip_newlines | strip | remove_first: ':' | strip -%}
  {%- else -%}
    {%- assign xo_title = xo_inner | remove_first: '>' | strip_html | strip_newlines | strip | truncate: 40 -%}
    {%- assign xo_body = '' -%}
  {%- endif -%}
  {%- if xo_title != blank -%}
    {%- assign xo_card = xo_title | append: '^' | append: xo_body -%}
    {%- assign xo_cards = xo_cards | append: xo_card | append: '|' -%}
    {%- assign xo_count = xo_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

{%- if xo_count >= 2 -%}
{%- assign xo_card_list = xo_cards | split: '|' -%}

<style>
  .xo-ben {
    --xo-primary: #6B2D45;
    --xo-gold: #E2BD94;
    --xo-cream: #FBF3EF;
    --xo-ink: #2A1B22;
    --xo-muted: #6B5A62;
    background: var(--xo-cream);
    color: var(--xo-ink);
    padding: 40px 16px;
  }
  .xo-ben__inner { max-width: 1000px; margin: 0 auto; }
  .xo-ben .xo-ben__title {
    margin: 0 auto 24px;
    max-width: 640px;
    text-align: center;
    color: var(--xo-ink);
    font-size: 22px;
    font-weight: 700;
    line-height: 1.3;
  }
  .xo-ben .xo-ben__title::after {
    content: "";
    display: block;
    width: 56px;
    height: 3px;
    margin: 14px auto 0;
    border-radius: 3px;
    background: var(--xo-primary);
  }
  .xo-ben__grid { display: grid; gap: 14px; margin: 0; padding: 0; list-style: none; }
  .xo-ben__card {
    margin: 0;
    padding: 22px 20px;
    background: #fff;
    border: 1px solid rgba(107, 45, 69, .12);
    border-radius: 18px;
    box-shadow: 0 6px 18px rgba(107, 45, 69, .08);
  }
  .xo-ben__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin-bottom: 14px;
    border-radius: 14px;
    background: var(--xo-primary);
    color: var(--xo-gold);
  }
  .xo-ben__icon svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .xo-ben .xo-ben__h3 { margin: 0 0 6px; color: var(--xo-ink); font-size: 16px; font-weight: 700; line-height: 1.3; }
  .xo-ben .xo-ben__text { margin: 0; color: var(--xo-muted); font-size: 14px; line-height: 1.6; }
  @media (min-width: 750px) {
    .xo-ben { padding: 56px 24px; }
    .xo-ben .xo-ben__title { font-size: 30px; margin-bottom: 34px; }
    .xo-ben__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
    .xo-ben__card { padding: 28px 24px; }
  }
</style>

<section class="xo-ben" aria-labelledby="xo-ben-title">
  <div class="xo-ben__inner">

    <h2 class="xo-ben__title" id="xo-ben-title">Por qué te va a encantar</h2>

    <ul class="xo-ben__grid">
      {%- for card in xo_card_list -%}
        {%- assign xo_pair = card | split: '^' -%}
        {%- if xo_pair[0] != blank -%}
      <li class="xo-ben__card">
        <span class="xo-ben__icon">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            {%- assign xo_slot = forloop.index0 | modulo: 3 -%}
            {%- if xo_slot == 0 -%}
            <circle cx="12" cy="12" r="9"/><path d="M8.5 12l2.5 2.5 4.5-5"/>
            {%- elsif xo_slot == 1 -%}
            <path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3z"/>
            {%- else -%}
            <path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>
            {%- endif -%}
          </svg>
        </span>
        <h3 class="xo-ben__h3">{{ xo_pair[0] | escape_once }}</h3>
        {%- if xo_pair[1] != blank -%}
        <p class="xo-ben__text">{{ xo_pair[1] | escape_once }}</p>
        {%- endif -%}
      </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

  </div>
</section>
{%- endif -%}

{% endif %}