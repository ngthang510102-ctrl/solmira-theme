{%- comment -%}
  Lớp giao diện "nữ tính" cho mẫu kinh-wo: chữ serif thanh lịch, bo góc mềm, nút dạng viên thuốc, nền hồng phấn xen kem,
  biểu tượng tròn hồng, dấu ✦ champagne thay gạch chân. Chỉ CSS. Muốn bỏ: xóa dòng render khỏi mẫu kinh-wo.
{%- endcomment -%}
{% if template.suffix == 'kinh-wo' %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&display=swap">
<style>
  :root {
    --xo-serif: "Cormorant Garamond", Georgia, "Times New Roman", serif;
    --xo-blush: #F8E8E6;
    --xo-blush-deep: #F1D3D6;
    --xo-rose: #C2416E;
    --xo-plum: #6B2D45;
    --xo-champagne: #E2BD94;
  }
  body { background: #FFFBF8 !important; }

  /* ---- Tiêu đề: serif thanh lịch + dấu ✦ ---- */
  body .xo-title-wrap .xo-title-h1 {
    font-family: var(--xo-serif) !important; font-weight: 600 !important; letter-spacing: 0 !important;
    font-size: 36px !important; line-height: 1.08 !important;
  }
  body .xo-ben .xo-ben__title, body .xo-howto .xo-howto__title, body .xo-cta .xo-cta__title,
  body #jfease-reviews-2026 h2 {
    font-family: var(--xo-serif) !important; font-weight: 600 !important; letter-spacing: 0 !important;
    font-size: 32px !important; line-height: 1.15 !important;
  }
  body .xo-ben .xo-ben__title::after, body .xo-howto .xo-howto__title::after {
    content: "✦ ✦ ✦" !important; width: auto !important; height: auto !important; background: none !important;
    margin: 10px auto 0 !important; color: var(--xo-champagne); font-size: 11px; letter-spacing: .6em; font-family: Arial, sans-serif;
  }
  body .xo-ben__h3, body .xo-howto .xo-howto__h3 {
    font-family: var(--xo-serif) !important; font-size: 21px !important; font-weight: 700 !important; letter-spacing: 0 !important;
  }
  body .xo-cta .xo-cta__sub { font-style: normal; letter-spacing: .08em; text-transform: uppercase; font-size: 12.5px; }
  @media (min-width: 750px) {
    body .xo-title-wrap .xo-title-h1 { font-size: 44px !important; }
    body .xo-ben .xo-ben__title, body .xo-howto .xo-howto__title, body .xo-cta .xo-cta__title, body #jfease-reviews-2026 h2 { font-size: 42px !important; }
  }

  /* ---- Nền xen kẽ hồng phấn / kem ---- */
  body .xo-ben { background: linear-gradient(180deg, #FFFBF8 0%, var(--xo-blush) 100%) !important; }
  body .xo-howto { background: #FFFBF8 !important; }
  body .xo-cta { background: linear-gradient(180deg, #FFFBF8 0%, var(--xo-blush) 100%) !important; }

  /* ---- Thẻ & biểu tượng ---- */
  body .xo-ben__card, body .xo-howto__body {
    border-radius: 26px !important; border: 1px solid rgba(226, 189, 148, .55) !important;
    box-shadow: 0 14px 34px rgba(194, 65, 110, .10) !important; background: #fff !important;
  }
  body .xo-ben__icon, body .xo-acc__ico, body .xo-howto__bubble {
    border-radius: 50% !important;
    background: linear-gradient(135deg, #FBE6E6 0%, var(--xo-blush-deep) 100%) !important;
    color: var(--xo-plum) !important; border: 1px solid rgba(226, 189, 148, .8);
  }
  body .xo-howto__bubble { box-shadow: 0 0 0 4px #FFFBF8, 0 6px 14px rgba(194, 65, 110, .18) !important; }
  body .xo-acc__item { border-radius: 22px !important; border-color: rgba(226, 189, 148, .6) !important; }
  body .xo-acc__trigger { font-family: var(--xo-serif) !important; font-size: 19px !important; font-weight: 700 !important; }
  body .xo-li { background: var(--xo-blush) !important; color: var(--xo-plum) !important; }
  body .xo-badge, body .xo-box, body .xo-note { border-color: rgba(226, 189, 148, .8) !important; background: #FFF7F4 !important; }
  body .xo-hl li::before { background: var(--xo-rose) !important; }

  /* ---- Ảnh sản phẩm bo mềm ---- */
  .product__media-list .product-media-container, .product__media-wrapper .media { border-radius: 26px !important; overflow: hidden; }

  /* ---- Giá & huy hiệu ---- */
  body .xophia-price-now { font-family: var(--xo-serif) !important; font-size: 38px !important; font-weight: 700 !important; color: var(--xo-rose) !important; }
  body .xophia-price-badge { background: var(--xo-rose) !important; color: #fff !important; }
  body .xophia-price-line { border-color: rgba(226, 189, 148, .7) !important; }

  /* ---- Nút: dạng viên thuốc ---- */
  cod-form .cod-submit.button, .xo-cta__btn, .sticky-buy-bar .button, sticky-buy-bar .button { border-radius: 999px !important; }
  body .xo-cta__inner { border-radius: 32px !important; }

  /* ---- Thanh tin cậy: chữ nhỏ viết hoa, thanh lịch ---- */
  .xo-trust__item { letter-spacing: .06em !important; text-transform: uppercase; font-size: 10.5px !important; }
  @media (min-width: 750px) { .xo-trust__item { font-size: 11.5px !important; } }
</style>
{% endif %}
