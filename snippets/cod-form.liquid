{%- comment -%}
  Cash-on-delivery order form (replaces the cart/checkout for ad traffic).
  Posts to the Google Apps Script set in Theme settings → Formulario COD, which writes the order
  to Google Sheets, Pancake POS and Shopify. Prices are re-read on the server; the totals here
  are only for display.

  No shipping to Baleares, Canarias, Ceuta and Melilla: the form blocks the order when the province
  or the postal code (07, 35, 38, 51, 52) belongs to one of them and explains why to the customer.

  Accepts:
  - product: {Object} the product being sold
{%- endcomment -%}
{%- liquid
  assign endpoint = settings.cod_form_endpoint | strip
  assign current_variant = product.selected_or_first_available_variant
-%}

{%- style -%}
  .cod-open {
    width: 100%;
    flex-direction: column;
    gap: 0.2rem;
    min-height: 5.6rem;
    padding: 0.8rem 1.5rem;
  }
  .cod-open__title { font-size: 1.7rem; font-weight: 700; letter-spacing: 0.06rem; }
  .cod-open__subtitle { font-size: 1.3rem; opacity: 0.9; }
  .cod-whatsapp { margin: 1rem 0 0; padding: 1rem 1.2rem; border-radius: 0.6rem; background: #e8f5e9; color: #1b5e20; font-size: 1.3rem; line-height: 1.45; }

  .cod-dialog {
    width: min(52rem, 100vw);
    max-height: 100dvh;
    padding: 0;
    border: none;
    border-radius: 0.8rem;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }
  .cod-dialog::backdrop { background: rgba(0, 0, 0, 0.55); }
  @media screen and (max-width: 749px) {
    .cod-dialog { width: 100vw; height: 100dvh; max-width: none; border-radius: 0; }
  }
  .cod-dialog__inner { padding: 2rem; }
  .cod-dialog__header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
  .cod-dialog__header h2 { margin: 0; font-size: 1.9rem; }
  .cod-dialog__close { background: none; border: none; cursor: pointer; font-size: 2.6rem; line-height: 1; color: inherit; padding: 0.4rem; }

  .cod-summary { display: flex; gap: 1.2rem; align-items: center; padding: 1.2rem; border: 1px solid rgba(var(--color-foreground), 0.12); border-radius: 0.6rem; }
  .cod-summary img { width: 6.4rem; height: 6.4rem; object-fit: cover; border-radius: 0.4rem; flex: none; }
  .cod-summary__info { flex: 1; min-width: 0; font-size: 1.4rem; }
  .cod-summary__info p { margin: 0; }
  .cod-summary__title { font-weight: 600; }
  .cod-totals { margin: 1rem 0 1.6rem; font-size: 1.4rem; }
  .cod-totals div { display: flex; justify-content: space-between; padding: 0.3rem 0; }
  .cod-totals .cod-totals__total { font-weight: 700; font-size: 1.7rem; border-top: 1px solid rgba(var(--color-foreground), 0.12); margin-top: 0.4rem; padding-top: 0.8rem; }

  .cod-ship { margin: 0 0 1.4rem; }
  .cod-ship h3 { margin: 0 0 0.8rem; font-size: 1.7rem; }
  .cod-ship__option { display: flex; align-items: center; gap: 1.4rem; padding: 1.2rem 1.6rem; border: 1px solid rgba(var(--color-foreground), 0.2); border-radius: 0.6rem; }
  .cod-ship__radio { flex: none; width: 2rem; height: 2rem; border-radius: 50%; border: 0.2rem solid rgb(var(--color-foreground)); box-shadow: inset 0 0 0 0.3rem rgb(var(--color-background)); background: rgb(var(--color-foreground)); }
  .cod-ship__text { flex: 1; font-size: 1.5rem; line-height: 1.35; }
  .cod-ship__text small { display: block; font-size: 1.4rem; opacity: 0.6; }
  .cod-ship__price { font-weight: 700; font-size: 1.5rem; }

  /* Label on the left, icon + input on the right (stacked on very narrow phones) */
  .cod-field { display: grid; grid-template-columns: 11rem 1fr; align-items: center; column-gap: 1.2rem; row-gap: 0.4rem; margin-bottom: 1.2rem; }
  .cod-field > label { font-size: 1.4rem; font-weight: 700; line-height: 1.3; }
  .cod-field > label .cod-req { color: #d0021b; }
  .cod-input { display: flex; align-items: stretch; min-width: 0; border: 1px solid rgba(var(--color-foreground), 0.25); border-radius: 0.5rem; overflow: hidden; background: rgb(var(--color-background)); }
  .cod-input:focus-within { border-color: rgb(var(--color-foreground)); }
  .cod-input__icon { flex: none; display: flex; align-items: center; justify-content: center; width: 4.4rem; background: rgba(var(--color-foreground), 0.08); border-right: 1px solid rgba(var(--color-foreground), 0.15); }
  .cod-input__icon svg { width: 2rem; height: 2rem; }
  .cod-input input, .cod-field select {
    flex: 1; min-width: 0; font: inherit; font-size: 1.6rem; padding: 1.1rem 1.2rem;
    border: none; outline: none; background: transparent; color: inherit;
  }
  .cod-field select { border: 1px solid rgba(var(--color-foreground), 0.25); border-radius: 0.5rem; background: rgb(var(--color-background)); }
  .cod-field select:focus { border-color: rgb(var(--color-foreground)); }
  .cod-field[data-invalid] .cod-input, .cod-field select[aria-invalid='true'] { border-color: #c0392b; }
  .cod-field__error { grid-column: 2; color: #c0392b; font-size: 1.3rem; }
  .cod-field__error:empty { display: none; }
  .cod-consent { display: flex; align-items: center; gap: 1rem; margin: 0.4rem 0 1.4rem; font-size: 1.5rem; cursor: pointer; }
  .cod-consent input { width: 2rem; height: 2rem; margin: 0; flex: none; }
  @media screen and (max-width: 359px) {
    .cod-field { grid-template-columns: 1fr; }
    .cod-field__error { grid-column: 1; }
  }
  .cod-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .cod-submit { width: 100%; min-height: 5.2rem; font-size: 1.7rem; font-weight: 700; margin-top: 0.6rem; }
  .cod-note { font-size: 1.3rem; text-align: center; opacity: 0.8; margin: 1rem 0 0; }
  .cod-message { font-size: 1.4rem; color: #c0392b; margin: 1rem 0 0; }
  .cod-message:empty { display: none; }
  .cod-shipnote { margin: 0 0 1.4rem; padding: 0.9rem 1.2rem; border-radius: 0.6rem; background: #fff4e5; color: #7a4a00; font-size: 1.3rem; line-height: 1.45; }
  .cod-block { margin: 0 0 1.2rem; padding: 1.1rem 1.3rem; border: 1px solid #e0a39b; border-radius: 0.6rem; background: #fdecea; color: #8a1f11; font-size: 1.4rem; line-height: 1.5; }
  .cod-block[hidden] { display: none; }
  .cod-block strong { display: block; margin-bottom: 0.3rem; font-size: 1.5rem; }
  .cod-done { text-align: center; padding: 2rem 0; }
  .cod-done__icon { font-size: 4.8rem; line-height: 1; }
  .cod-done h3 { font-size: 2.2rem; margin: 1rem 0; }
{%- endstyle -%}

<cod-form class="cod-form" data-endpoint="{{ endpoint | escape }}" data-default-variant="{{ current_variant.id }}">
  <script type="application/json" data-product>
    {
      "title": {{ product.title | json }},
      "image": {{ product.featured_media | image_url: width: 200 | json }},
      "variants": [
        {%- for variant in product.variants -%}
          {
            "id": {{ variant.id }},
            "title": {{ variant.title | json }},
            "options": {{ variant.options | json }},
            "price": {{ variant.price }},
            "available": {{ variant.available | json }},
            "qty": {% if variant.sku contains 'x' %}{{ variant.sku | split: 'x' | last | plus: 0 | at_least: 1 }}{% else %}1{% endif %},
            "image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 200 | json }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>

  <button type="button" class="button button--primary cod-open" id="cod-open" {% if endpoint == blank %}disabled{% endif %}>
    <span class="cod-open__title">COMPRAR AHORA</span>
    <span class="cod-open__subtitle">Pago al recibir · Envío gratis</span>
  </button>
  <p class="cod-whatsapp">
    📲 Después de tu pedido te escribiremos por <strong>WhatsApp en menos de 24 horas</strong> para confirmarlo.
    Asegúrate de que tu número esté disponible.
  </p>
  {%- if endpoint == blank and request.design_mode -%}
    <p class="cod-message">Falta la URL del servidor en Configuración del tema → Formulario COD.</p>
  {%- endif -%}

  <dialog class="cod-dialog" aria-labelledby="cod-dialog-title">
    <div class="cod-dialog__inner">
      <div class="cod-dialog__header">
        <h2 id="cod-dialog-title">Rellena tus datos y paga al recibir</h2>
        <button type="button" class="cod-dialog__close" data-close aria-label="Cerrar">&times;</button>
      </div>

      <div data-step="form">
        <div class="cod-summary">
          <img src="" alt="" width="64" height="64" data-summary-image>
          <div class="cod-summary__info">
            <p class="cod-summary__title" data-summary-title></p>
            <p data-summary-variant></p>
          </div>
        </div>
        <div class="cod-totals">
          <div><span>Subtotal</span><span data-summary-price></span></div>
          <div><span>Envío</span><span>Gratis</span></div>
          <div class="cod-totals__total"><span>Total a pagar al recibir</span><span data-summary-total></span></div>
        </div>

        <div class="cod-ship">
          <h3>Opciones de envío</h3>
          <div class="cod-ship__option">
            <span class="cod-ship__radio" aria-hidden="true"></span>
            <span class="cod-ship__text">Envío gratis a la España peninsular<small>Pagas al recibir en casa</small></span>
            <span class="cod-ship__price">GRATIS</span>
          </div>
        </div>

        <p class="cod-shipnote">📍 Solo enviamos a la España peninsular. <strong>No realizamos envíos a Baleares, Canarias, Ceuta ni Melilla.</strong></p>

        <form novalidate>
          <div class="cod-field">
            <label for="cod-name">Nombre completo <span class="cod-req">*</span></label>
            <div class="cod-input">
              <span class="cod-input__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 2a8 8 0 0 1 6.3 12.9C16.9 15.1 14.6 14 12 14s-4.9 1.1-6.3 2.9A8 8 0 0 1 12 4Zm0 2.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z"/></svg></span>
              <input id="cod-name" name="name" autocomplete="name" required minlength="3" maxlength="80" placeholder="Nombre completo">
            </div>
            <span class="cod-field__error" data-error-for="name"></span>
          </div>
          <div class="cod-field">
            <label for="cod-phone">Teléfono <span class="cod-req">*</span></label>
            <div class="cod-input">
              <span class="cod-input__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg></span>
              <input id="cod-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required value="+34 " placeholder="+34">
            </div>
            <span class="cod-field__error" data-error-for="phone"></span>
          </div>
          <div class="cod-field">
            <label for="cod-email">Email</label>
            <div class="cod-input">
              <span class="cod-input__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M2 5h20v14H2V5Zm2 2v.5l8 5 8-5V7H4Zm16 2.8-8 5-8-5V17h16V9.8Z"/></svg></span>
              <input id="cod-email" name="email" type="email" inputmode="email" autocomplete="email" maxlength="120" placeholder="Email (opcional)">
            </div>
            <span class="cod-field__error" data-error-for="email"></span>
          </div>
          <div class="cod-field">
            <label for="cod-address">Dirección <span class="cod-req">*</span></label>
            <div class="cod-input">
              <span class="cod-input__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a7 7 0 0 0-7 7c0 5.3 7 13 7 13s7-7.7 7-13a7 7 0 0 0-7-7Zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5Z"/></svg></span>
              <input id="cod-address" name="address" autocomplete="street-address" required minlength="5" maxlength="160" placeholder="Calle, número, piso y puerta">
            </div>
            <span class="cod-field__error" data-error-for="address"></span>
          </div>
          <div class="cod-field">
            <label for="cod-province">Provincia <span class="cod-req">*</span></label>
            <select id="cod-province" name="provinceId" required>
              <option value="">Provincia</option>
              {%- render 'cod-form-provinces' -%}
            </select>
            <span class="cod-field__error" data-error-for="provinceId"></span>
          </div>
          <div class="cod-field">
            <label for="cod-zip">Código postal <span class="cod-req">*</span></label>
            <div class="cod-input">
              <span class="cod-input__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M9 4 7 20M17 4l-2 16M4 9h16M3 15h16"/></svg></span>
              <input id="cod-zip" name="zip" inputmode="numeric" autocomplete="postal-code" required maxlength="5" placeholder="Código postal (ej: 28001)">
            </div>
            <span class="cod-field__error" data-error-for="zip"></span>
          </div>
          <div class="cod-field">
            <label for="cod-note">Nota</label>
            <div class="cod-input">
              <span class="cod-input__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9h2M11 9h6M7 13h2M11 13h6M7 17h10"/></svg></span>
              <input id="cod-note" name="note" maxlength="200" placeholder="Nota para el repartidor (opcional)">
            </div>
          </div>
          <label class="cod-consent">
            <input type="checkbox" name="marketing" value="1">
            Acepto recibir ofertas por email
          </label>
          <div class="cod-block" role="alert" data-block hidden>
            <strong>Lo sentimos, no podemos enviar a esta dirección</strong>
            No realizamos envíos a <b>Baleares, Canarias, Ceuta ni Melilla</b>, porque nuestra logística y el pago contra reembolso solo cubren la España peninsular. Por eso no podemos aceptar tu pedido con esta dirección. Si tienes otra dirección de entrega en la península, puedes usarla.
          </div>
          <div class="cod-hp" aria-hidden="true">
            <label for="cod-website">No rellenar</label>
            <input id="cod-website" name="website" tabindex="-1" autocomplete="off">
          </div>

          <button type="submit" class="button button--primary cod-submit" data-submit></button>
          <p class="cod-message" role="alert" data-message></p>
          <p class="cod-note">Te escribiremos por WhatsApp en menos de 24 horas para confirmar tu pedido. Comprueba que tu número es correcto.</p>
        </form>
      </div>

      <div class="cod-done" data-step="done" hidden>
        <div class="cod-done__icon" aria-hidden="true">✅</div>
        <h3>¡Pedido recibido!</h3>
        <p>Gracias. En las próximas horas te contactaremos por WhatsApp para confirmar tu pedido.</p>
        <p>Referencia: <strong data-done-ref></strong></p>
        <button type="button" class="button button--secondary" data-close>Seguir viendo</button>
      </div>
    </div>
  </dialog>
</cod-form>

<script>
  (function () {
    // First-touch ad attribution for the order (kept for the browser session).
    try {
      const params = new URLSearchParams(location.search);
      const keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'utm_id', 'fbclid'];
      if (keys.some((k) => params.get(k)) && !sessionStorage.getItem('cod_utm')) {
        const utm = {};
        keys.forEach((k) => params.get(k) && (utm[k] = params.get(k)));
        sessionStorage.setItem('cod_utm', JSON.stringify(utm));
        sessionStorage.setItem('cod_landing', location.href);
      }
    } catch (e) {}
  })();

  if (!customElements.get('cod-form')) {
    // Areas we do not ship to: Illes Balears, Las Palmas, Santa Cruz de Tenerife, Ceuta, Melilla.
    // Province values come from snippets/cod-form-provinces.liquid; zip prefixes are the postal-code provinces
    // 07 (Baleares), 35 and 38 (Canarias), 51 (Ceuta), 52 (Melilla).
    const BLOCKED_PROVINCES = ['34_R042', '34_R013', '34_R014', '34_R034', '34_R035'];
    const BLOCKED_ZIP_PREFIXES = ['07', '35', '38', '51', '52'];

    customElements.define(
      'cod-form',
      class CodForm extends HTMLElement {
        connectedCallback() {
          this.product = JSON.parse(this.querySelector('[data-product]').textContent);
          this.dialog = this.querySelector('dialog');
          this.form = this.querySelector('form');
          this.submitButton = this.querySelector('[data-submit]');
          this.blockBox = this.querySelector('[data-block]');
          this.querySelector('#cod-open').addEventListener('click', () => this.open());
          this.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => this.dialog.close()));
          this.form.addEventListener('submit', (event) => {
            event.preventDefault();
            this.submit();
          });
          this.form.addEventListener('input', (event) => {
            this.setError(event.target.name, '');
            if (event.target.name === 'zip') this.updateBlock();
          });
          this.form.addEventListener('change', (event) => {
            if (event.target.name === 'provinceId' || event.target.name === 'zip') this.updateBlock();
          });
        }

        // True when the province or the postal code is in an area we do not ship to.
        isBlocked() {
          const province = this.form.elements.provinceId ? this.form.elements.provinceId.value : '';
          const zip = this.form.elements.zip ? this.form.elements.zip.value.trim() : '';
          return (
            BLOCKED_PROVINCES.indexOf(province) >= 0 ||
            (zip.length >= 2 && BLOCKED_ZIP_PREFIXES.indexOf(zip.slice(0, 2)) >= 0)
          );
        }

        // Shows the explanation and disables the order button while the address is not shippable.
        updateBlock() {
          const blocked = this.isBlocked();
          this.blockBox.hidden = !blocked;
          const available = this.variant ? this.variant.available : true;
          this.submitButton.disabled = blocked || !available;
          return blocked;
        }

        selectedVariant() {
          const variants = this.product.variants;
          const picked = [...document.querySelectorAll('variant-selects fieldset, variant-selects select')].map((el) => {
            if (el.tagName === 'SELECT') return el.value;
            const checked = el.querySelector('input:checked');
            return checked ? checked.value : null;
          });
          const byOptions =
            picked.length && picked.every(Boolean)
              ? variants.find((v) => v.options.every((o, i) => o === picked[i]))
              : null;
          const fromUrl = Number(new URLSearchParams(location.search).get('variant'));
          return (
            byOptions ||
            variants.find((v) => v.id === fromUrl) ||
            variants.find((v) => v.id === Number(this.dataset.defaultVariant)) ||
            variants[0]
          );
        }

        money(cents) {
          return (cents / 100).toLocaleString('es-ES', { style: 'currency', currency: 'EUR' });
        }

        open() {
          this.variant = this.selectedVariant();
          const v = this.variant;
          this.querySelector('[data-summary-image]').src = v.image || this.product.image || '';
          this.querySelector('[data-summary-title]').textContent = this.product.title;
          this.querySelector('[data-summary-variant]').textContent = v.title;
          this.querySelector('[data-summary-price]').textContent = this.money(v.price);
          this.querySelector('[data-summary-total]').textContent = this.money(v.price);
          this.submitButton.textContent = 'CONFIRMAR PEDIDO · ' + this.money(v.price);
          this.submitButton.disabled = !v.available;
          this.querySelector('[data-message]').textContent = v.available ? '' : 'Esta opción está agotada. Elige otra.';
          this.updateBlock();
          this.querySelector('[data-step="form"]').hidden = false;
          this.querySelector('[data-step="done"]').hidden = true;
          this.openedAt = Date.now();
          this.dialog.showModal();
          this.dispatchEvent(new CustomEvent('cod:open', { bubbles: true, detail: this.trackingDetail() }));
        }

        trackingDetail() {
          return {
            variantId: String(this.variant.id),
            quantity: this.variant.qty || 1,
            value: this.variant.price / 100,
            currency: 'EUR',
          };
        }

        setError(name, message) {
          const field = this.form.elements[name];
          const slot = this.querySelector(`[data-error-for="${name}"]`);
          if (!field || !slot) return;
          slot.textContent = message;
          field.setAttribute('aria-invalid', message ? 'true' : 'false');
          field.closest('.cod-field').toggleAttribute('data-invalid', Boolean(message));
        }

        check(data) {
          const errors = {};
          const phone = data.phone.replace(/[\s().-]/g, '').replace(/^(\+34|0034)/, '');
          if (data.name.trim().length < 3) errors.name = 'Escribe tu nombre y apellidos.';
          if (!/^[6789]\d{8}$/.test(phone)) errors.phone = 'Escribe un teléfono español de 9 cifras.';
          if (data.email.trim() && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email.trim())) errors.email = 'Revisa tu email o déjalo vacío.';
          if (data.address.trim().length < 5) errors.address = 'Escribe la calle, el número, el piso y la puerta.';
          if (!data.provinceId) errors.provinceId = 'Elige tu provincia.';
          if (!/^\d{5}$/.test(data.zip.trim())) errors.zip = 'El código postal tiene 5 cifras.';
          return errors;
        }

        async submit() {
          // No shipping to Baleares, Canarias, Ceuta and Melilla: stop here and show why.
          if (this.updateBlock()) {
            this.blockBox.scrollIntoView({ block: 'center', behavior: 'smooth' });
            return;
          }

          const data = Object.fromEntries(new FormData(this.form).entries());
          const errors = this.check(data);
          ['name', 'phone', 'email', 'address', 'provinceId', 'zip'].forEach((n) => this.setError(n, errors[n] || ''));
          const firstInvalid = Object.keys(errors)[0];
          if (firstInvalid) {
            this.form.elements[firstInvalid].focus();
            return;
          }

          let utm = {};
          let link = location.href;
          try {
            utm = JSON.parse(sessionStorage.getItem('cod_utm') || '{}');
            link = sessionStorage.getItem('cod_landing') || link;
          } catch (e) {}

          const message = this.querySelector('[data-message]');
          message.textContent = '';
          this.submitButton.disabled = true;
          this.submitButton.textContent = 'Enviando…';
          try {
            // A plain string body is sent as text/plain, a "simple" request with no CORS preflight,
            // which Apps Script web apps accept.
            const response = await fetch(this.dataset.endpoint, {
              method: 'POST',
              body: JSON.stringify({
                ...data,
                variantId: String(this.variant.id),
                utm,
                link,
                elapsedMs: Date.now() - this.openedAt,
              }),
            });
            const result = await response.json();
            if (!result.ok) throw new Error(result.error || 'error');
            this.querySelector('[data-done-ref]').textContent = result.ref;
            this.querySelector('[data-step="form"]').hidden = true;
            this.querySelector('[data-step="done"]').hidden = false;
            this.form.reset();
            // A repeated submit returns the first order's ref; count the sale only once.
            if (!result.duplicate) {
              this.dispatchEvent(
                new CustomEvent('cod:ordered', {
                  bubbles: true,
                  detail: { ...this.trackingDetail(), ref: result.ref },
                })
              );
            }
          } catch (error) {
            const fieldFor = { phone: 'phone', zip: 'zip', province: 'provinceId', name: 'name', address: 'address', email: 'email' };
            if (fieldFor[error.message]) this.setError(fieldFor[error.message], 'Revisa este dato.');
            message.textContent = 'No hemos podido enviar tu pedido. Revisa tus datos e inténtalo de nuevo.';
          } finally {
            this.submitButton.disabled = false;
            this.submitButton.textContent = 'CONFIRMAR PEDIDO · ' + this.money(this.variant.price);
            this.updateBlock();
          }
        }
      }
    );
  }
</script>

{%- if product.template_suffix contains 'vacuum' -%}
<style>
  .cod-qty { display: inline-flex; align-items: center; margin-top: 0.6rem; border: 1px solid rgba(var(--color-foreground), 0.3); border-radius: 0.5rem; }
  .cod-qty button { width: 3.6rem; height: 3.6rem; border: 0; background: none; font-size: 2.2rem; line-height: 1; cursor: pointer; color: inherit; }
.cod-summary img[data-summary-image] { width: 10rem; height: 6.4rem; object-fit: contain; }  .cod-qty span { min-width: 3rem; text-align: center; font-weight: 700; font-size: 1.6rem; }
</style>
<script>
  (function () {
    customElements.whenDefined('cod-form').then(function () {
      var P = customElements.get('cod-form').prototype;
      if (P.__codQty) return;
      P.__codQty = true;
      var baseOpen = P.open;
      P.codRender = function () {
        var v = this.variant, n = v.qty || 1;
        this.querySelector('[data-qty-val]').textContent = n;
        this.querySelector('[data-summary-variant]').textContent = n + (n === 1 ? ' combo' : ' combos') + ' = ' + n * 3 + ' bolsas de vacío';
        this.querySelector('[data-summary-price]').textContent = this.money(v.price);
        this.querySelector('[data-summary-total]').textContent = this.money(v.price);
        this.submitButton.textContent = 'CONFIRMAR PEDIDO · ' + this.money(v.price);
        this.updateBlock();
      };
      P.codSetQty = function (n) {
        var max = Math.max.apply(null, this.product.variants.map(function (x) { return x.qty || 1; }));
        n = Math.min(Math.max(n, 1), max);
        var nv = this.product.variants.find(function (x) { return (x.qty || 1) === n && x.available; });
        if (!nv) return;
        this.variant = nv;
        this.codRender();
        try {
          var inp = document.querySelector('[data-jf-packs] .jf-pack[data-jf-pack="' + nv.title + '"] input');
          if (inp && !inp.checked) inp.click();
        } catch (e) {}
      };
      P.open = function () {
        baseOpen.call(this);
        this.querySelector('[data-summary-image]').src = 'https://cdn.shopify.com/s/files/1/0838/2277/2375/files/combo3-bolsas.png?v=1794387742';
        if (!this.querySelector('[data-qty-val]')) {
          var box = document.createElement('div');
          box.className = 'cod-qty';
          box.innerHTML = '<button type="button" data-qty-minus aria-label="Menos">&minus;</button><span data-qty-val>1</span><button type="button" data-qty-plus aria-label="Más">+</button>';
          this.querySelector('.cod-summary__info').appendChild(box);
          var self = this;
          box.querySelector('[data-qty-minus]').addEventListener('click', function () { self.codSetQty((self.variant.qty || 1) - 1); });
          box.querySelector('[data-qty-plus]').addEventListener('click', function () { self.codSetQty((self.variant.qty || 1) + 1); });
        }
        this.codRender();
      };
    });
  })();
</script>
{%- endif -%}
