{%- comment -%}
  Mô tả sản phẩm dạng accordion "Detalles del producto".
  Dùng trong block Custom Liquid của main-product: {% render 'xophia-wo-details' %}
  Chỉ hiển thị ở mẫu product.kinh. Dùng cho mọi sản phẩm. Hiện NGUYÊN BẢN product.description. Màu navy #6B2D45.
{%- endcomment -%}
{% if template.suffix == 'kinh-wo' and product != blank %}

<style>
/* XOPHIA SPAIN - PRODUCT DETAILS ACCORDION */

.xophia-details {
  width: 100%;
  margin: 14px 0;
  border-top: 1px solid rgba(107, 45, 69, .16);
  border-bottom: 1px solid rgba(107, 45, 69, .16);
  font-family: Arial, Helvetica, sans-serif;
  color: #2A1B22;
}

.xophia-details summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  min-height: 60px;
  padding: 17px 3px;
  cursor: pointer;
  list-style: none;
  color: #2A1B22;
  font-size: 16px;
  font-weight: 600;
}

.xophia-details summary::-webkit-details-marker { display: none; }
.xophia-details summary::marker { content: ""; }
.xophia-details-title { flex: 1; }

.xophia-details-icon {
  position: relative;
  width: 18px;
  height: 18px;
  flex-shrink: 0;
}

.xophia-details-icon::before,
.xophia-details-icon::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  background: #6B2D45;
  transform: translate(-50%, -50%);
  transition: transform .2s ease;
}

.xophia-details-icon::before { width: 16px; height: 1.5px; }
.xophia-details-icon::after { width: 1.5px; height: 16px; }
.xophia-details[open] .xophia-details-icon::after { transform: translate(-50%, -50%) rotate(90deg); }

.xophia-details-content {
  padding: 0 3px 22px;
  color: #3b3b3b;
  font-size: 14px;
  line-height: 1.75;
  overflow-wrap: anywhere;
}

.xophia-details-content p { margin: 0 0 14px; }
.xophia-details-content h2,
.xophia-details-content h3,
.xophia-details-content h4 { margin: 18px 0 10px; color: #2A1B22; font-weight: 700; line-height: 1.4; }
.xophia-details-content ul,
.xophia-details-content ol { margin: 10px 0 16px; padding-left: 22px; }
.xophia-details-content li { margin-bottom: 7px; }
.xophia-details-content img { display: block; max-width: 100%; height: auto; margin: 15px auto; }
.xophia-details-content a { color: #6B2D45; text-decoration: underline; }
.xophia-details-content table { display: block; max-width: 100%; overflow-x: auto; }
.xophia-details summary:focus-visible { outline: 2px solid #6B2D45; outline-offset: 3px; }

@media (max-width: 749px) {
  .xophia-details summary { min-height: 54px; padding: 15px 2px; font-size: 15px; }
  .xophia-details-content { padding: 0 2px 18px; font-size: 13px; line-height: 1.7; }
}
</style>

<details class="xophia-details">
  <summary>
    <span class="xophia-details-title">Detalles del producto</span>
    <span class="xophia-details-icon" aria-hidden="true"></span>
  </summary>

  <div class="xophia-details-content">
    {% if product.description != blank %}
      {{ product.description }}
    {% else %}
      <p>La descripción de este producto estará disponible próximamente.</p>
    {% endif %}
  </div>
</details>

{% endif %}