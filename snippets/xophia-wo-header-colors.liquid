{%- comment -%}
  ĐỒNG BỘ MÀU THANH THÔNG BÁO + HEADER + MENU TRƯỢT (hamburger) cho mẫu product.kinh
  (tông xanh navy #6B2D45, nền kem #FBF3EF, chữ #2A1B22). Cũng ẩn sọc kẹo đỏ trắng dưới header.
  CHỈ CHẠY Ở MẪU "kinh": mọi trang/mẫu khác giữ nguyên màu cũ.
  Muốn đổi màu: sửa mã màu ở "BẢNG MÀU" bên dưới.
  Muốn bỏ hẳn: xóa dòng {% render 'xophia-wo-header-colors' %} khỏi section đầu trang của mẫu kinh.
{%- endcomment -%}
{% if template.suffix == 'kinh-wo' %}
<style>
  /* ============ BẢNG MÀU (sửa mã màu ở đây) ============ */
  :root {
    --xo-announce-bg:   #6B2D45;   /* nền thanh thông báo */
    --xo-announce-text: #FFF4EE;   /* chữ + mũi tên thanh thông báo */
    --xo-header-bg:     #FBF3EF;   /* nền header */
    --xo-header-line:   rgba(107, 45, 69, .14); /* đường kẻ dưới header */
    --xo-logo:          #6B2D45;   /* chữ logo JFEASE */
    --xo-icons:         #6B2D45;   /* icon menu, tìm kiếm, tài khoản, giỏ hàng */
    --xo-menu-text:     #2A1B22;   /* chữ menu trên desktop */
    --xo-drawer-bg:     #FBF3EF;   /* nền menu trượt trên mobile */
    --xo-drawer-text:   #2A1B22;   /* chữ menu trượt */
    --xo-drawer-accent: #6B2D45;   /* điểm nhấn: hover, nút đóng, mục đang chọn */
  }

  /* ---- Thanh thông báo ---- */
  .utility-bar.color-scheme-3 { background: var(--xo-announce-bg) !important; background-image: none !important; }
  .utility-bar .announcement-bar__message,
  .utility-bar .announcement-bar__link,
  .utility-bar .announcement-bar__link * { color: var(--xo-announce-text) !important; }
  .utility-bar .slider-button,
  .utility-bar .slider-button .icon { color: var(--xo-announce-text) !important; }

  /* ---- Header ---- */
  .header-wrapper { background: var(--xo-header-bg) !important; background-image: none !important; }
  .header-wrapper--border-bottom { border-bottom-color: var(--xo-header-line) !important; }
  .header-wrapper .header__heading-link,
  .header-wrapper .header__heading-link .h2,
  .header-wrapper .header__heading-link span { color: var(--xo-logo) !important; }
  .header-wrapper .header__icon,
  .header-wrapper .header__icon .icon { color: var(--xo-icons) !important; }
  .header-wrapper .header__menu-item,
  .header-wrapper .header__menu-item span { color: var(--xo-menu-text) !important; }

  /* ---- Menu trượt (hamburger) trên mobile ---- */
  .menu-drawer,
  .menu-drawer.gradient { background: var(--xo-drawer-bg) !important; background-image: none !important; }
  .menu-drawer__inner-container,
  .menu-drawer__navigation-container,
  .menu-drawer__navigation { background: transparent !important; }
  .menu-drawer__menu-item,
  .menu-drawer__menu-item span,
  .menu-drawer__menu-item .icon,
  .menu-drawer__utility-links a,
  .menu-drawer__account { color: var(--xo-drawer-text) !important; }
  .menu-drawer__menu-item:hover,
  .menu-drawer__menu-item:focus-visible,
  .menu-drawer__menu-item[aria-current="page"],
  .menu-drawer__menu-item[aria-current="page"] span,
  .menu-drawer__utility-links a:hover,
  .menu-drawer__account:hover { color: var(--xo-drawer-accent) !important; }
  .menu-drawer__close-button,
  .menu-drawer__close-button .icon { color: var(--xo-drawer-accent) !important; }

  /* ---- Ẩn sọc kẹo đỏ trắng dưới header ---- */
  .header-wrapper::after { display: none !important; content: none !important; }
</style>
{% endif %}