{%- comment -%}
  Seasonal Christmas decoration, switched on/off in Theme settings → Navidad:
  - a string of blinking lights across the top of the page
  - light snowfall over the page (canvas, never blocks clicks, paused when the tab is hidden)
  Both are skipped for visitors who ask for reduced motion, and the snow is lighter on phones.
{%- endcomment -%}
{%- if settings.xmas_enable -%}
  {%- if settings.xmas_lights -%}
    <div class="xmas-lights" aria-hidden="true">
      {%- for i in (1..40) -%}<span></span>{%- endfor -%}
    </div>
  {%- endif -%}
  {%- if settings.xmas_snow -%}
    <canvas class="xmas-snow" aria-hidden="true"></canvas>
  {%- endif -%}

  <style>
    .xmas-lights {
      position: relative;
      z-index: 5;
      display: flex;
      justify-content: space-between;
      height: 2.2rem;
      padding: 0 0.6rem;
      overflow: hidden;
      background: #0f3d2e;
    }
    .xmas-lights::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: 0.45rem;
      border-top: 0.2rem solid #2b2b2b;
      border-radius: 50%;
    }
    .xmas-lights span {
      position: relative;
      flex: 0 0 auto;
      width: 0.8rem;
      height: 1.3rem;
      margin-top: 0.6rem;
      border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
      background: #f25a1f;
      box-shadow: 0 0.2rem 1rem 0.1rem #f25a1f;
      animation: xmas-blink 1.6s ease-in-out infinite;
    }
    .xmas-lights span:nth-child(4n + 2) { background: #ffd23f; box-shadow: 0 0.2rem 1rem 0.1rem #ffd23f; animation-delay: 0.4s; }
    .xmas-lights span:nth-child(4n + 3) { background: #3ddc84; box-shadow: 0 0.2rem 1rem 0.1rem #3ddc84; animation-delay: 0.8s; }
    .xmas-lights span:nth-child(4n + 4) { background: #4fc3f7; box-shadow: 0 0.2rem 1rem 0.1rem #4fc3f7; animation-delay: 1.2s; }
    @media screen and (max-width: 749px) {
      .xmas-lights span:nth-child(n + 21) { display: none; }
    }
    @keyframes xmas-blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.35; box-shadow: none; }
    }
    .xmas-snow {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 99;
      pointer-events: none;
    }
    @media (prefers-reduced-motion: reduce) {
      .xmas-lights span { animation: none; }
      .xmas-snow { display: none; }
    }
  </style>

  {%- if settings.xmas_snow -%}
    <script>
      (function () {
        var canvas = document.querySelector('.xmas-snow');
        if (!canvas || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var ctx = canvas.getContext('2d');
        var flakes = [];
        var width, height, frame;

        function resize() {
          var ratio = window.devicePixelRatio || 1;
          width = window.innerWidth;
          height = window.innerHeight;
          canvas.width = width * ratio;
          canvas.height = height * ratio;
          ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
          var count = width < 750 ? 35 : 70;
          while (flakes.length < count) flakes.push(newFlake(true));
          flakes.length = count;
        }

        function newFlake(anywhere) {
          return {
            x: Math.random() * width,
            y: anywhere ? Math.random() * height : -10,
            r: 1 + Math.random() * 2.5,
            speed: 0.4 + Math.random() * 1,
            drift: Math.random() * Math.PI * 2,
            alpha: 0.5 + Math.random() * 0.5,
          };
        }

        function draw() {
          ctx.clearRect(0, 0, width, height);
          for (var i = 0; i < flakes.length; i++) {
            var f = flakes[i];
            f.y += f.speed;
            f.drift += 0.01;
            f.x += Math.sin(f.drift) * 0.4;
            if (f.y > height + 10) flakes[i] = f = newFlake(false);
            ctx.beginPath();
            ctx.arc(f.x, f.y, f.r, 0, Math.PI * 2);
            // Pale blue rather than pure white, so flakes stay visible over the white page.
            ctx.fillStyle = 'rgba(190, 215, 235, ' + f.alpha + ')';
            ctx.shadowColor = 'rgba(90, 120, 150, 0.5)';
            ctx.shadowBlur = 2;
            ctx.fill();
          }
          frame = requestAnimationFrame(draw);
        }

        document.addEventListener('visibilitychange', function () {
          if (document.hidden) cancelAnimationFrame(frame);
          else frame = requestAnimationFrame(draw);
        });
        window.addEventListener('resize', resize);
        resize();
        frame = requestAnimationFrame(draw);
      })();
    </script>
  {%- endif -%}
{%- endif -%}
