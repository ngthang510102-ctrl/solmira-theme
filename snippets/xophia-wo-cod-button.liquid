{%- comment -%}
  Nút mua màu CAM SÁNG #C2416E (chỉ ở mẫu product.kinh) để nổi bật trên nền navy/kem:
  - Nút "COMPRAR AHORA" chính (#cod-open của snippets/cod-form), góc vuông, chữ trắng đậm, bóng đổ cam, nhấp nhẹ.
  - Nút "Comprar ahora" trên thanh mua cố định (sticky-buy-bar).
  Chỉ có CSS. Không sửa cod-form.liquid hay sticky-buy-bar.liquid.
  Muốn đổi màu: sửa #C2416E (nền) và #A8325A (hover) bên dưới.
{%- endcomment -%}
{% if template.suffix == 'kinh-wo' %}
<style>
/* NÚT COD CHÍNH */

cod-form #cod-open.button {
  --buttons-radius: 999px;
  --buttons-radius-outset: 999px;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 2px !important;
  width: 100% !important;
  min-height: 62px !important;
  padding: 16px 20px !important;
  border: 0 !important;
  border-radius: 999px !important;
  background: #C2416E !important;
  background-image: none !important;
  color: #FFFFFF !important;
  box-shadow: 0 8px 18px rgba(194, 65, 110, .4) !important;
  font-family: Arial, Helvetica, sans-serif !important;
  line-height: 1.35 !important;
  text-align: center !important;
  cursor: pointer;
  transition: background .2s ease, transform .15s ease !important;
  animation: xo-cod-pulse 2.6s ease-in-out infinite;
}

@keyframes xo-cod-pulse {
  0%, 78%, 100% { transform: scale(1); }
  89% { transform: scale(1.025); }
}

@media (prefers-reduced-motion: reduce) {
  cod-form #cod-open.button { animation: none; }
}

cod-form #cod-open.button::before,
cod-form #cod-open.button::after {
  display: none !important;
  content: none !important;
  box-shadow: none !important;
}

cod-form #cod-open.button:hover:not(:disabled) {
  background: #A8325A !important;
  box-shadow: 0 10px 22px rgba(168, 50, 90, .45) !important;
  animation: none;
}

cod-form #cod-open.button:focus-visible {
  outline: 3px solid #2A1B22 !important;
  outline-offset: 3px !important;
}

cod-form #cod-open.button:disabled {
  opacity: .55;
  cursor: not-allowed;
  animation: none;
}

cod-form #cod-open .cod-open__title {
  color: #FFFFFF !important;
  font-size: 17px !important;
  font-weight: 800 !important;
  line-height: 1.35 !important;
  letter-spacing: .02em !important;
}

cod-form #cod-open .cod-open__subtitle {
  color: #FFFFFF !important;
  font-size: 13px !important;
  font-weight: 400 !important;
  line-height: 1.35 !important;
  opacity: .95 !important;
}

/* NÚT TRÊN THANH MUA CỐ ĐỊNH (STICKY BUY BAR) */

sticky-buy-bar .button.button--primary {
  --color-button: 247, 107, 21;
  --color-button-text: 255, 255, 255;
  background-color: #C2416E !important;
  background-image: none !important;
  color: #FFFFFF !important;
  font-weight: 800 !important;
}

sticky-buy-bar .button.button--primary:hover {
  background-color: #A8325A !important;
}

@media (max-width: 749px) {
  cod-form #cod-open.button {
    min-height: 58px !important;
    padding: 14px !important;
  }

  cod-form #cod-open .cod-open__title {
    font-size: 15px !important;
  }

  cod-form #cod-open .cod-open__subtitle {
    font-size: 12px !important;
  }
}
</style>
{% endif %}