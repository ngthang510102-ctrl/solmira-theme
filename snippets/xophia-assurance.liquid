{%- comment -%}
  3 huy hiệu an tâm ngay dưới nút mua COD. Chỉ dùng thông tin đúng với chính sách cửa hàng.
  Dùng trong block Custom Liquid chứa cod-form: {% render 'xophia-assurance' %}   Chỉ chạy ở mẫu product.kinh.
  Có gọi thêm xophia-order-data (nhãn tpl + dữ liệu đơn), xophia-qty (số lượng) và xophia-form-style (giao diện form), chỉ ở Kinh.
{%- endcomment -%}
{% if template.suffix == 'kinh' %}
{% render 'xophia-order-data' %}
{% render 'xophia-qty' %}
{% render 'xophia-form-style' %}
<style>
  .xo-assure {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  .xo-assure li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 10px 6px;
    border: 1px solid rgba(107, 36, 41, .16);
    border-radius: 12px;
    background: #fdfbf7;
    color: #1a1a1a;
    font-size: 11.5px;
    font-weight: 600;
    line-height: 1.3;
    text-align: center;
  }
  .xo-assure svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: #6b2429;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (min-width: 750px) {
    .xo-assure li { flex-direction: row; justify-content: center; text-align: left; font-size: 12.5px; }
  }
</style>
<ul class="xo-assure" aria-label="Garantías de compra">
  <li>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>
    <span>Sin riesgo: sin tarjeta, pagas al recibir</span>
  </li>
  <li>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7l9-4 9 4v10l-9 4-9-4V7z"/><path d="M3 7l9 4 9-4M12 11v10"/></svg>
    <span>Comprueba el paquete al recibirlo</span>
  </li>
  <li>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 0 1-14 5.3"/><path d="M4 12a8 8 0 0 1 14-5.3"/><path d="M18 3v4h-4M6 21v-4h4"/></svg>
    <span>30 días de garantía</span>
  </li>
</ul>
{% endif %}