{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "rating": {
          "type": "rating",
          "settings": {}
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "cod_highlight": {
          "type": "text",
          "settings": {
            "text": "<strong>Pago contra reembolso:</strong> pagas en efectivo al recibir tu pedido.",
            "text_style": "body"
          }
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "text_style": "body",
            "inventory_threshold": 10,
            "show_inventory_quantity": true
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false
          }
        },
        "trust_icons": {
          "type": "icon-with-text",
          "settings": {
            "layout": "vertical",
            "icon_1": "truck",
            "heading_1": "Envío a toda España",
            "icon_2": "lock",
            "heading_2": "Pago al recibir",
            "icon_3": "return",
            "heading_3": "14 días para devolver"
          }
        },
        "description": {
          "type": "description"
        },
        "tab_shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Envío y entrega",
            "icon": "truck",
            "content": "<p>Enviamos a toda la España peninsular. Plazo de entrega estimado: <strong>[COMPLETAR] días laborables</strong> desde la confirmación del pedido.</p><p>Te contactaremos por teléfono o WhatsApp para confirmar tu pedido antes del envío.</p>"
          }
        },
        "tab_cod": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Pago contra reembolso",
            "icon": "lock",
            "content": "<p>No necesitas tarjeta. Pagas el importe del pedido en efectivo al repartidor en el momento de la entrega.</p>"
          }
        },
        "tab_returns": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Devoluciones",
            "icon": "return",
            "content": "<p>Tienes <strong>14 días naturales</strong> desde la recepción para desistir de tu compra, sin necesidad de justificación. Consulta nuestra política de devoluciones para conocer el procedimiento.</p>"
          }
        },
        "tab_faq": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Preguntas frecuentes",
            "icon": "question_mark",
            "content": "<p><strong>¿Cómo hago el pedido?</strong><br>Elige la opción que quieras, pulsa el botón de compra y rellena tus datos de entrega.</p><p><strong>¿Cuándo pago?</strong><br>Al recibir el paquete, en efectivo.</p><p><strong>¿Puedo cancelar mi pedido?</strong><br>Sí, contáctanos antes de que se envíe.</p>"
          }
        }
      },
      "block_order": [
        "rating",
        "title",
        "price",
        "cod_highlight",
        "inventory",
        "variant_picker",
        "buy_buttons",
        "trust_icons",
        "description",
        "tab_shipping",
        "tab_cod",
        "tab_returns",
        "tab_faq"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": true,
        "padding_top": 24,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "heading": "Información del producto",
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "how_to_order": {
      "type": "multicolumn",
      "blocks": {
        "step_1": {
          "type": "column",
          "settings": {
            "title": "1. Elige",
            "text": "<p>Selecciona el modelo y la cantidad.</p>"
          }
        },
        "step_2": {
          "type": "column",
          "settings": {
            "title": "2. Rellena tus datos",
            "text": "<p>Nombre, teléfono y dirección de entrega. Sin tarjeta.</p>"
          }
        },
        "step_3": {
          "type": "column",
          "settings": {
            "title": "3. Paga al recibir",
            "text": "<p>Te llamamos para confirmar y pagas en efectivo al repartidor.</p>"
          }
        }
      },
      "block_order": [
        "step_1",
        "step_2",
        "step_3"
      ],
      "settings": {
        "title": "Cómo hacer tu pedido",
        "heading_size": "h2",
        "image_width": "third",
        "image_ratio": "adapt",
        "columns_desktop": 3,
        "column_alignment": "center",
        "background_style": "primary",
        "button_label": "",
        "color_scheme": "scheme-2",
        "columns_mobile": "1",
        "swipe_on_mobile": false,
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "También te puede gustar",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "sticky_buy_bar": {
      "type": "sticky-buy-bar",
      "settings": {
        "button_label": "Comprar ahora"
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "how_to_order",
    "related-products",
    "sticky_buy_bar"
  ]
}
