lumn; gap:18px; padding:22px 20px;\n  border-radius:20px; color:#fff; overflow:hidden;\n  background:linear-gradient(135deg,var(--navy) 0%,var(--navy-dark) 100%);\n  border:1px solid rgba(255,255,255,.1);\n  box-shadow:0 20px 40px -14px rgba(74,29,47,.45);\n}\n#jfease-reviews-2026 .jfr-score-box::after {\n  content:\"\"; position:absolute; top:-50px; right:-50px; width:170px; height:170px;\n  border-radius:50%; background:radial-gradient(circle,rgba(199,155,106,.28) 0,transparent 68%);\n  pointer-events:none;\n}\n#jfease-reviews-2026 .jfr-score-left {\n  position:relative; z-index:1; text-align:center; padding-bottom:16px;\n  border-bottom:1px solid rgba(255,255,255,.14);\n}\n#jfease-reviews-2026 .jfr-big-num { font-size:48px; line-height:1; font-weight:900; letter-spacing:-1.5px; }\n#jfease-reviews-2026 .jfr-score-stars { margin:8px 0 5px; color:var(--gold); font-size:17px; letter-spacing:3px; }\n#jfease-reviews-2026 .jfr-score-sub { display:block; color:rgba(255,255,255,.74); font-size:11.5px; }\n#jfease-reviews-2026 .jfr-score-bars { position:relative; z-index:1; display:flex; flex-direction:column; gap:10px; }\n#jfease-reviews-2026 .jfr-bar-row { display:flex; align-items:center; gap:10px; color:rgba(255,255,255,.88); font-size:12px; }\n#jfease-reviews-2026 .jfr-bar-row span { width:28px; flex:0 0 28px; color:var(--gold); font-weight:800; }\n#jfease-reviews-2026 .jfr-bar-track { flex:1; height:8px; background:rgba(255,255,255,.14); border-radius:99px; overflow:hidden; }\n#jfease-reviews-2026 .jfr-bar-fill { height:100%; border-radius:99px; background:linear-gradient(90deg,var(--gold),#E8C9A0); }\n#jfease-reviews-2026 .jfr-bar-row strong { width:34px; flex:0 0 34px; text-align:right; font-size:11.5px; }\n\n/* BANG CHUYEN */\n#jfease-reviews-2026 .jfr-window {\n  width:100%; overflow:hidden; padding:10px 0 20px;\n  -webkit-mask-image:linear-gradient(to right,transparent 0,#000 7%,#000 93%,transparent 100%);\n  mask-image:linear-gradient(to right,transparent 0,#000