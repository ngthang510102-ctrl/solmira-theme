{%- comment -%}
  Contenido de la landing de cajas de almacenaje plegables (template product.landing-storage-bags).
  Las 6 infografías (t6 a t11) ya llevan su título y sus textos en español dentro de la imagen, así que van a
  ancho completo; alrededor solo hay promesa y un único botón final. Va después de jf-landing.
{%- endcomment -%}
<div class="jf jf-sb">
  <style>
    .jf-sb { background: #fdf8f1; }
    .jf-sb__fig { max-width: 720px; margin: 0 auto; }
    .jf-sb__fig img { display: block; width: 100%; height: auto; }
    .jf-sb__sec { padding: 28px 16px; }
    .jf-sb__sec--alt { background: #f5ebe1; }
    .jf-sb__in { max-width: 560px; margin: 0 auto; }
    .jf-sb h2 { text-align: center; font-size: 22px; font-weight: 800; line-height: 1.2; }
    .jf-sb__cta { display: block; width: 100%; max-width: 360px; margin: 0 auto; padding: 14px 16px; border: 0; border-radius: 12px; background: var(--jf-cta); color: #fff; font-family: var(--jf-font-title); font-weight: 800; font-size: 17px; letter-spacing: .02em; cursor: pointer; }
    .jf-sb__cta-sub { display: block; margin-top: 8px; text-align: center; font-size: 12.5px; color: var(--jf-ink-soft); }
    .jf-sb__note { margin: 0; padding: 10px 16px 18px; text-align: center; font-size: 11.5px; color: var(--jf-ink-soft); }
    .jf-sb__guar { display: grid; gap: 10px; margin-top: 18px; }
    .jf-sb__g { display: flex; align-items: center; gap: 12px; padding: 14px; border-radius: 12px; background: #fff; font-size: 14px; }
    .jf-sb__g svg { flex: none; width: 32px; height: 32px; color: var(--jf-accent); }
    .jf-sb__g b { display: block; font-family: var(--jf-font-title); }
    .jf-sb__final { padding: 24px 16px 32px; }
    @media (min-width: 1024px) { .jf-sb__in { max-width: 760px; } .jf-sb h2 { font-size: 26px; } }
  </style>

  {%- liquid
    assign keys = 'img_fold,img_rooms,img_car,img_carry,img_calm,img_size' | split: ','
    assign alts = 'Caja de almacenaje plegable: úsala, pliégala, guárdala|Perfecta para cada rincón de tu casa: debajo de la cama, en el armario, ropa de cama y habitación infantil|Organiza el maletero del coche como un profesional|Fácil de llevar y fácil de apilar: asas resistentes, estructura reforzada, cremallera suave y diseño plegable|Del desorden diario a la calma en casa: antes y después|Medidas del producto: 38 x 28 x 32 cm' | split: '|'
  -%}
  {%- for key in keys -%}
    {%- assign im = section.settings[key] -%}
    {%- if im != blank -%}
      <div class="jf-sb__fig">
        {{ im | image_url: width: 1000 | image_tag: widths: '500, 750, 1000', sizes: '(min-width: 760px) 720px, 100vw', loading: 'lazy', alt: alts[forloop.index0] }}
      </div>
    {%- endif -%}
  {%- endfor -%}
  <p class="jf-sb__note">Imágenes ilustrativas.</p>

  <section class="jf-sb__sec jf-sb__sec--alt">
    <div class="jf-sb__in">
      <h2>Nuestra promesa</h2>
      <div class="jf-sb__guar">
        <div class="jf-sb__g"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 4.5-3.2 8-8 9-4.8-1-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5L16 9.5"/></svg><span><b>Garantía de 30 días</b>Si hay un defecto de fabricación, te ayudamos a solucionarlo.</span></div>
        <div class="jf-sb__g"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13v-1a8 8 0 0 1 16 0v1"/><rect x="3" y="13" width="4" height="6" rx="1.5"/><rect x="17" y="13" width="4" height="6" rx="1.5"/></svg><span><b>Atención al cliente</b>Te escribimos en 24 h para confirmar tu pedido.</span></div>
        <div class="jf-sb__g"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/></svg><span><b>Pago al recibir</b>Pagas en efectivo al repartidor cuando llega tu pedido.</span></div>
      </div>
    </div>
  </section>

  <div class="jf-sb__final">
    <button type="button" class="jf-sb__cta" data-jf-go>{{ section.settings.cta }}</button>
    {%- if section.settings.cta_sub != blank -%}<span class="jf-sb__cta-sub">{{ section.settings.cta_sub }}</span>{%- endif -%}
  </div>

  <script>
    (function () {
      if (window.__jfVsGo) return;
      window.__jfVsGo = true;
      document.addEventListener('click', function (e) {
        var b = e.target.closest('[data-jf-go]');
        if (!b) return;
        var main = document.querySelector('.jf-cta--main');
        if (main) { main.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
      });
    })();
  </script>
</div>

{% schema %}
{
  "name": "Contenido almacenaje",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "cta", "label": "Texto del botón final", "default": "PEDIR AHORA" },
    { "type": "text", "id": "cta_sub", "label": "Línea bajo el botón", "default": "Pago al recibir · Envío gratis" },
    { "type": "header", "content": "Infografías (en orden de aparición)" },
    { "type": "image_picker", "id": "img_fold", "label": "1 · t6 – Úsala. Pliégala. Guárdala." },
    { "type": "image_picker", "id": "img_rooms", "label": "2 · t7 – Perfecta para cada rincón de tu casa" },
    { "type": "image_picker", "id": "img_car", "label": "3 · t8 – Organiza el maletero" },
    { "type": "image_picker", "id": "img_carry", "label": "4 · t9 – Fácil de llevar. Fácil de apilar." },
    { "type": "image_picker", "id": "img_calm", "label": "5 · t10 – Del desorden diario a la calma" },
    { "type": "image_picker", "id": "img_size", "label": "6 · t11 – Medidas del producto" }
  ],
  "presets": [{ "name": "Contenido almacenaje" }]
}
{% endschema %}