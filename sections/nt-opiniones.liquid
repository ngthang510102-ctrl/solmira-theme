{%- comment -%}
  Khối "Opiniones de clientes" kiểu mẫu Kinh, GÕ TAY trong Customize (theme win win).
  Mỗi đánh giá là 1 block "Opinión": Sản phẩm, Nombre, Título, Texto, Etiqueta, Estrellas, Compra verificada, Tarjeta oscura.
  Block CHỈ hiện ở đúng sản phẩm đã chọn trong ô "Sản phẩm" hoặc có "Mã sản phẩm (handle)" trùng (dùng cho sản phẩm còn nháp). Để trống cả 2 = không hiện.
  Câu giới thiệu: lấy metafield custom.nt_reviews_intro của sản phẩm, không có thì dùng câu chung của section.
  Điểm trung bình, sao và thanh % tự tính từ các block. Không có block nào -> khối ẩn.
{%- endcomment -%}
{%- liquid
  assign count = 0
  assign total = 0
  assign c5 = 0
  assign c4 = 0
  assign c3 = 0
  for b in section.blocks
    if b.settings.nombre == blank or b.settings.texto == blank
      continue
    endif
    assign ok = false
    if b.settings.producto != blank and b.settings.producto.id == product.id
      assign ok = true
    endif
    if b.settings.producto_handle != blank and b.settings.producto_handle == product.handle
      assign ok = true
    endif
    unless ok
      continue
    endunless
    assign st = b.settings.estrellas | plus: 0
    assign count = count | plus: 1
    assign total = total | plus: st
    if st == 5
      assign c5 = c5 | plus: 1
    elsif st == 4
      assign c4 = c4 | plus: 1
    else
      assign c3 = c3 | plus: 1
    endif
  endfor
  assign rid = 'ntr-' | append: section.id
-%}
{%- if count > 0 -%}
{%- liquid
  assign avg = total | times: 1.0 | divided_by: count | round: 1
  assign avg_round = avg | round
  assign p5 = c5 | times: 100.0 | divided_by: count | round
  assign p4 = c4 | times: 100.0 | divided_by: count | round
  assign p3 = c3 | times: 100.0 | divided_by: count | round
  assign intro = product.metafields.custom.nt_reviews_intro.value | default: section.settings.intro
-%}
<div class="page-width" id="nt-opiniones">
<div id="{{ rid }}" class="ntr ntr-root" data-avg="{{ avg }}" data-count="{{ count }}" style="--ntr-speed: {{ section.settings.speed | times: count }}s;">
  <div class="ntr-container">
    <div class="ntr-head">
      <div class="ntr-title">
        <div class="ntr-eyebrow"><span>✦</span> {{ section.settings.eyebrow | escape }}</div>
        <h2>{{ section.settings.heading | escape }} <span>{{ section.settings.heading_mark | escape }}</span></h2>
        {%- if intro != blank -%}<p>{{ intro | escape }}</p>{%- endif -%}
        <div class="ntr-pills">
          {%- if section.settings.pill_1 != blank or section.settings.pill_2 != blank -%}
            {%- if section.settings.pill_1 != blank -%}<div class="ntr-pill"><svg viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.7-9.3a1 1 0 00-1.4-1.4L9 10.6 7.7 9.3a1 1 0 00-1.4 1.4l2 2a1 1 0 001.4 0l4-4z" fill="currentColor"/></svg><span>{{ section.settings.pill_1 | escape }}</span></div>{%- endif -%}
            {%- if section.settings.pill_2 != blank -%}<div class="ntr-pill"><svg viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.7-9.3a1 1 0 00-1.4-1.4L9 10.6 7.7 9.3a1 1 0 00-1.4 1.4l2 2a1 1 0 001.4 0l4-4z" fill="currentColor"/></svg><span>{{ section.settings.pill_2 | escape }}</span></div>{%- endif -%}
          {%- else -%}
            <div class="ntr-pill"><svg viewBox="0 0 20 20"><path d="M10 1.8l2.5 5.2 5.7.8-4.1 4 1 5.7L10 14.8l-5.1 2.7 1-5.7-4.1-4 5.7-.8z" fill="currentColor"/></svg><span>{{ avg }} de 5</span></div>
          {%- endif -%}
        </div>
      </div>
      <div class="ntr-score">
        <div class="ntr-score__left">
          <div class="ntr-big">{{ avg }}</div>
          <div class="ntr-score__stars">{% for i in (1..5) %}{% if i <= avg_round %}★{% else %}☆{% endif %}{% endfor %}</div>
          <span class="ntr-score__sub">Valoración media</span>
        </div>
        <div class="ntr-bars">
          <div class="ntr-bar"><span>5 ★</span><div class="ntr-bar__track"><div class="ntr-bar__fill" style="width: {{ p5 }}%;"></div></div><strong>{{ p5 }}%</strong></div>
          <div class="ntr-bar"><span>4 ★</span><div class="ntr-bar__track"><div class="ntr-bar__fill" style="width: {{ p4 }}%;"></div></div><strong>{{ p4 }}%</strong></div>
          <div class="ntr-bar"><span>≤3 ★</span><div class="ntr-bar__track"><div class="ntr-bar__fill" style="width: {{ p3 }}%;"></div></div><strong>{{ p3 }}%</strong></div>
        </div>
      </div>
    </div>
  </div>

  {%- capture cards -%}
    {%- for b in section.blocks -%}
      {%- liquid
        if b.settings.nombre == blank or b.settings.texto == blank
          continue
        endif
        assign ok = false
        if b.settings.producto != blank and b.settings.producto.id == product.id
          assign ok = true
        endif
        if b.settings.producto_handle != blank and b.settings.producto_handle == product.handle
          assign ok = true
        endif
        unless ok
          continue
        endunless
        assign name = b.settings.nombre
        assign st = b.settings.estrellas | plus: 0
        assign words = name | split: ' '
        assign ini = words[0] | slice: 0 | upcase
        if words.size > 1
          assign ini2 = words[1] | slice: 0 | upcase
          assign ini = ini | append: ini2
        endif
      -%}
      <article class="ntr-card{% if b.settings.destacada %} ntr-card--navy{% endif %}" {{ b.shopify_attributes }}>
        <div class="ntr-card__top">
          <div class="ntr-stars">{% for i in (1..st) %}★{% endfor %}</div>
          {%- if b.settings.etiqueta != blank -%}<span class="ntr-tag">{{ b.settings.etiqueta | escape }}</span>{%- endif -%}
        </div>
        {%- if b.settings.titulo != blank -%}<h3>«{{ b.settings.titulo | escape }}»</h3>{%- endif -%}
        <p>{{ b.settings.texto | escape | newline_to_br }}</p>
        <div class="ntr-foot">
          <span class="ntr-avatar">{{ ini | escape }}</span>
          <div class="ntr-person"><strong>{{ name | escape }}</strong><small>Cliente JFEASE</small></div>
          {%- if b.settings.verificada -%}
            <span class="ntr-verified"><svg viewBox="0 0 16 16" fill="none"><path d="M13.3 4.3L6.5 11.1L2.7 7.3" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>Compra verificada</span>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  {%- endcapture -%}

  <div class="ntr-window{% if count < 3 %} ntr-window--static{% endif %}">
    <div class="ntr-track">
      <div class="ntr-set">{{ cards }}</div>
      {%- if count >= 3 -%}<div class="ntr-set" aria-hidden="true">{{ cards }}</div>{%- endif -%}
    </div>
  </div>
</div>
</div>

<style>
#{{ rid }}, #{{ rid }} * { box-sizing: border-box; }
#{{ rid }} {
  --navy:#1d5c3a; --navy-dark:#0f3a24; --navy-soft:#e7f2ea; --cream:#fffaf3; --cream-2:#fbeee3; --red:#b8232f; --red-dark:#8f1621;
  --gold:#d9a23b; --gold-soft:#f6e6c4; --text:#1f2a24; --muted:#5f6b63; --border:#ecdcc8;
  position:relative; width:100%; margin:0 0 17px; padding:28px 0 22px; overflow:hidden;
  font-family:Arial,Helvetica,sans-serif; color:var(--text);
  background:radial-gradient(circle at 100% 0%, rgba(184,35,47,.10) 0, transparent 40%), radial-gradient(circle at 0% 100%, rgba(29,92,58,.10) 0, transparent 45%), linear-gradient(180deg,var(--cream) 0%,var(--cream-2) 100%);
  border:1px solid var(--border); border-radius:20px; container-type:inline-size; container-name:ntr;
}
#{{ rid }} .ntr-container { padding:0 16px; }
#{{ rid }} .ntr-head { display:grid; grid-template-columns:minmax(0,1fr); gap:22px; margin-bottom:26px; }
#{{ rid }} .ntr-title { text-align:center; }
#{{ rid }} .ntr-eyebrow { display:inline-flex; align-items:center; gap:8px; margin-bottom:14px; padding:7px 14px; border-radius:30px; background:var(--red); color:#fff; font-size:10.5px; font-weight:800; letter-spacing:1.8px; box-shadow:0 6px 16px rgba(184,35,47,.28); }
#{{ rid }} .ntr-eyebrow span { color:var(--gold); font-size:12px; }
#{{ rid }} h2 { margin:0 0 12px; color:var(--navy-dark); font-size:clamp(24px,6.6cqw,36px); line-height:1.15; font-weight:900; letter-spacing:-.6px; overflow-wrap:break-word; }
#{{ rid }} h2 span { color:var(--red); background:linear-gradient(transparent 62%, rgba(220,167,67,.42) 62%); padding:0 3px; }
#{{ rid }} .ntr-title p { margin:0 auto 18px; max-width:520px; color:var(--muted); font-size:14px; line-height:1.68; }
#{{ rid }} .ntr-pills { display:flex; flex-wrap:wrap; justify-content:center; gap:8px; }
#{{ rid }} .ntr-pill { display:inline-flex; align-items:center; gap:7px; padding:8px 13px; background:#fff; border:1px solid var(--border); border-radius:30px; color:var(--navy); font-size:12px; font-weight:800; line-height:1.3; box-shadow:0 3px 10px rgba(15,58,36,.06); }
#{{ rid }} .ntr-pill svg { width:17px; height:17px; flex:0 0 17px; color:var(--gold); }
#{{ rid }} .ntr-score { position:relative; display:flex; flex-direction:column; gap:18px; padding:22px 20px; border-radius:20px; color:#fff; overflow:hidden; background:linear-gradient(135deg,var(--navy) 0%,var(--navy-dark) 100%); box-shadow:0 20px 40px -14px rgba(15,58,36,.45); }
#{{ rid }} .ntr-score::after { content:""; position:absolute; top:-50px; right:-50px; width:170px; height:170px; border-radius:50%; background:radial-gradient(circle,rgba(220,167,67,.28) 0,transparent 68%); pointer-events:none; }
#{{ rid }} .ntr-score__left { position:relative; z-index:1; text-align:center; padding-bottom:16px; border-bottom:1px solid rgba(255,255,255,.14); }
#{{ rid }} .ntr-big { font-size:48px; line-height:1; font-weight:900; letter-spacing:-1.5px; }
#{{ rid }} .ntr-score__stars { margin:8px 0 5px; color:var(--gold); font-size:17px; letter-spacing:3px; }
#{{ rid }} .ntr-score__sub { display:block; color:rgba(255,255,255,.74); font-size:11.5px; }
#{{ rid }} .ntr-bars { position:relative; z-index:1; display:flex; flex-direction:column; gap:10px; }
#{{ rid }} .ntr-bar { display:flex; align-items:center; gap:10px; color:rgba(255,255,255,.88); font-size:12px; }
#{{ rid }} .ntr-bar span { width:34px; flex:0 0 34px; color:var(--gold); font-weight:800; }
#{{ rid }} .ntr-bar__track { flex:1; height:8px; background:rgba(255,255,255,.14); border-radius:99px; overflow:hidden; }
#{{ rid }} .ntr-bar__fill { height:100%; border-radius:99px; background:linear-gradient(90deg,var(--gold),#f4cc73); }
#{{ rid }} .ntr-bar strong { width:38px; flex:0 0 38px; text-align:right; font-size:11.5px; }
#{{ rid }} .ntr-window { width:100%; overflow:hidden; padding:10px 0 20px; -webkit-mask-image:linear-gradient(to right,transparent 0,#000 7%,#000 93%,transparent 100%); mask-image:linear-gradient(to right,transparent 0,#000 7%,#000 93%,transparent 100%); }
#{{ rid }} .ntr-track { display:flex; width:max-content; animation:ntr-marquee var(--ntr-speed, 90s) linear infinite; will-change:transform; }
#{{ rid }} .ntr-set { display:flex; flex:0 0 auto; gap:14px; padding-right:14px; }
#{{ rid }} .ntr-window--static { -webkit-mask-image:none; mask-image:none; }
#{{ rid }} .ntr-window--static .ntr-track { width:100%; animation:none; }
#{{ rid }} .ntr-window--static .ntr-set { flex-wrap:wrap; justify-content:center; padding:0 16px; }
#{{ rid }} .ntr-card { position:relative; display:flex; flex-direction:column; width:290px; min-height:262px; padding:22px 20px 18px; overflow:hidden; background:#fff; border:1px solid var(--border); border-radius:18px; box-shadow:0 12px 28px -10px rgba(15,58,36,.14); transition:transform .3s ease, box-shadow .3s ease; }
#{{ rid }} .ntr-card::before { content:""; position:absolute; top:0; left:0; right:0; height:4px; background:linear-gradient(90deg,var(--red) 0 50%,var(--navy) 50% 100%); }
#{{ rid }} .ntr-card::after { content:"\201C"; position:absolute; top:22px; right:16px; color:var(--gold-soft); font-family:Georgia,serif; font-size:78px; line-height:1; pointer-events:none; }
#{{ rid }} .ntr-card:hover { transform:translateY(-6px); box-shadow:0 22px 42px -12px rgba(15,58,36,.25); }
#{{ rid }} .ntr-card__top { position:relative; z-index:1; display:flex; align-items:center; justify-content:space-between; gap:8px; margin-bottom:14px; }
#{{ rid }} .ntr-stars { color:var(--gold); font-size:15px; letter-spacing:3px; line-height:1; }
#{{ rid }} .ntr-tag { padding:4px 10px; border-radius:6px; background:var(--navy-soft); color:var(--navy); font-size:10px; font-weight:800; letter-spacing:.3px; white-space:nowrap; }
#{{ rid }} .ntr-card h3 { position:relative; z-index:1; margin:0 0 9px; color:var(--navy-dark); font-size:17px; line-height:1.3; font-weight:900; }
#{{ rid }} .ntr-card p { position:relative; z-index:1; flex:1; margin:0; color:#4a5668; font-size:13.5px; line-height:1.7; }
#{{ rid }} .ntr-foot { position:relative; z-index:1; display:flex; flex-wrap:wrap; align-items:center; gap:9px 10px; margin-top:16px; padding-top:14px; border-top:1px solid #eef0f4; }
#{{ rid }} .ntr-avatar { flex:0 0 38px; width:38px; height:38px; display:flex; align-items:center; justify-content:center; border-radius:50%; background:var(--navy); color:#fff; border:2px solid var(--gold-soft); font-size:12px; font-weight:800; letter-spacing:.4px; }
#{{ rid }} .ntr-person { flex:1; min-width:70px; display:flex; flex-direction:column; gap:2px; }
#{{ rid }} .ntr-person strong { color:var(--navy-dark); font-size:13.5px; line-height:1.25; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
#{{ rid }} .ntr-person small { color:var(--muted); font-size:11px; }
#{{ rid }} .ntr-verified { display:inline-flex; align-items:center; gap:4px; padding:5px 10px; border-radius:30px; background:#e8f3ec; color:#1b6b3d; font-size:10px; font-weight:800; white-space:nowrap; }
#{{ rid }} .ntr-verified svg { width:11px; height:11px; flex:0 0 11px; color:#1b8a4b; }
#{{ rid }} .ntr-card--navy { background:linear-gradient(155deg,var(--navy) 0%,var(--navy-dark) 100%); border-color:transparent; box-shadow:0 18px 38px -12px rgba(15,58,36,.5); }
#{{ rid }} .ntr-card--navy::before { background:linear-gradient(90deg,var(--gold),#f4cc73); }
#{{ rid }} .ntr-card--navy::after { color:rgba(255,255,255,.08); }
#{{ rid }} .ntr-card--navy .ntr-tag { background:rgba(220,167,67,.18); color:#f7d788; border:1px solid rgba(220,167,67,.35); }
#{{ rid }} .ntr-card--navy h3 { color:#fff; }
#{{ rid }} .ntr-card--navy p { color:rgba(255,255,255,.86); }
#{{ rid }} .ntr-card--navy .ntr-foot { border-top-color:rgba(255,255,255,.16); }
#{{ rid }} .ntr-card--navy .ntr-avatar { background:var(--gold); color:var(--navy-dark); border-color:rgba(255,255,255,.3); }
#{{ rid }} .ntr-card--navy .ntr-person strong { color:#fff; }
#{{ rid }} .ntr-card--navy .ntr-person small { color:rgba(255,255,255,.66); }
#{{ rid }} .ntr-card--navy .ntr-verified { background:rgba(255,255,255,.14); color:#fff; }
#{{ rid }} .ntr-card--navy .ntr-verified svg { color:var(--gold); }
@keyframes ntr-marquee { from { transform:translateX(0); } to { transform:translateX(-50%); } }
@media (hover:hover) { #{{ rid }} .ntr-window:hover .ntr-track { animation-play-state:paused; } }
#{{ rid }} .ntr-window:active .ntr-track { animation-play-state:paused; }
@container ntr (min-width:720px) {
  #{{ rid }} { padding:48px 0 34px; border-radius:24px; }
  #{{ rid }} .ntr-container { padding:0 36px; }
  #{{ rid }} .ntr-head { grid-template-columns:minmax(0,1.2fr) minmax(0,.95fr); gap:40px; align-items:center; margin-bottom:38px; }
  #{{ rid }} .ntr-title { text-align:left; }
  #{{ rid }} .ntr-title p { margin-left:0; font-size:15.5px; }
  #{{ rid }} .ntr-pills { justify-content:flex-start; }
  #{{ rid }} h2 { font-size:clamp(30px,3.6cqw,40px); }
  #{{ rid }} .ntr-score { flex-direction:row; align-items:center; gap:26px; padding:26px 28px; }
  #{{ rid }} .ntr-score__left { flex:0 0 auto; padding:0 24px 0 0; border-bottom:0; border-right:1px solid rgba(255,255,255,.14); }
  #{{ rid }} .ntr-bars { flex:1; }
  #{{ rid }} .ntr-set { gap:22px; padding-right:22px; }
  #{{ rid }} .ntr-card { width:340px; min-height:270px; padding:26px 24px 20px; }
}
@container ntr (max-width:360px) {
  #{{ rid }} { padding:22px 0 18px; }
  #{{ rid }} .ntr-container { padding:0 12px; }
  #{{ rid }} .ntr-card { width:268px; padding:20px 16px 16px; }
  #{{ rid }} .ntr-big { font-size:42px; }
}
@media (prefers-reduced-motion:reduce) {
  #{{ rid }} .ntr-track { animation:none; }
  #{{ rid }} .ntr-window { overflow-x:auto; -webkit-mask-image:none; mask-image:none; padding-left:16px; }
  #{{ rid }} .ntr-card { transition:none; }
}
</style>
{%- endif -%}

{% schema %}
{
  "name": "Opiniones (gõ tay)",
  "tag": "section",
  "class": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Nhãn trên cùng", "default": "OPINIONES DE CLIENTES"},
    {"type": "text", "id": "heading", "label": "Tiêu đề", "default": "Lo que dicen quienes ya confían en"},
    {"type": "text", "id": "heading_mark", "label": "Chữ tô vàng cuối tiêu đề", "default": "JFEASE"},
    {"type": "textarea", "id": "intro", "label": "Câu giới thiệu", "default": "Descubre las experiencias de quienes ya han probado este producto.", "info": "Câu chung. Muốn câu riêng cho từng sản phẩm: điền metafield \"Texto opiniones (win-win)\" của sản phẩm đó."},
    {"type": "text", "id": "pill_1", "label": "Nhãn tròn 1", "info": "Để trống cả 2 nhãn thì tự hiện điểm trung bình"},
    {"type": "text", "id": "pill_2", "label": "Nhãn tròn 2"},
    {"type": "range", "id": "speed", "label": "Tốc độ chạy thẻ (giây cho mỗi thẻ, càng lớn càng chậm)", "min": 5, "max": 40, "step": 1, "unit": "s", "default": 15}
  ],
  "blocks": [
    {
      "type": "opinion",
      "name": "Opinión",
      "settings": [
        {"type": "product", "id": "producto", "label": "Sản phẩm (đánh giá chỉ hiện ở sản phẩm này)"},
        {"type": "text", "id": "producto_handle", "label": "Mã sản phẩm (handle) – dự phòng", "info": "Dùng khi sản phẩm còn nháp. Ví dụ: hucha-madera-reto-ahorro-1000-euros"},
        {"type": "text", "id": "nombre", "label": "Tên khách (Nombre)"},
        {"type": "text", "id": "titulo", "label": "Tiêu đề (Título)"},
        {"type": "textarea", "id": "texto", "label": "Nội dung đánh giá"},
        {"type": "text", "id": "etiqueta", "label": "Nhãn nhỏ góc phải (Etiqueta)"},
        {"type": "range", "id": "estrellas", "label": "Số sao", "min": 1, "max": 5, "step": 1, "default": 5},
        {"type": "checkbox", "id": "verificada", "label": "Hiện \"Compra verificada\"", "default": false},
        {"type": "checkbox", "id": "destacada", "label": "Thẻ nền tối (nổi bật)", "default": false}
      ]
    }
  ],
  "presets": [{"name": "Opiniones (gõ tay)"}]
}
{% endschema %}
