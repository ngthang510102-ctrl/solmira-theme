{%- comment -%}
  Row of short shop promises (free shipping, pay on delivery, returns…) with icons.
  Two columns on mobile, one row on desktop.
{%- endcomment -%}
{%- style -%}
  .trust-bar-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .trust-bar-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .trust-bar__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  @media screen and (min-width: 750px) {
    .trust-bar__list { grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, 1fr); }
  }
  .trust-bar__item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.2rem;
    border-radius: 1.2rem;
    background: rgba(var(--color-foreground), 0.04);
  }
  .trust-bar__icon {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: rgba(var(--color-button), 0.12);
    color: rgb(var(--color-button));
  }
  .trust-bar__icon svg { width: 2.2rem; height: 2.2rem; }
  .trust-bar__title { margin: 0; font-size: 1.4rem; font-weight: 600; line-height: 1.25; }
  .trust-bar__text { margin: 0.2rem 0 0; font-size: 1.2rem; line-height: 1.3; color: rgba(var(--color-foreground), 0.7); }
{%- endstyle -%}

<div class="trust-bar-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <ul class="trust-bar__list">
      {%- for block in section.blocks -%}
        <li class="trust-bar__item" {{ block.shopify_attributes }}>
          <span class="trust-bar__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'truck' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
              {%- when 'cash' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="6" width="19" height="12" rx="2"/><circle cx="12" cy="12" r="2.6"/><path d="M6 9.5v5M18 9.5v5"/></svg>
              {%- when 'return' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/></svg>
              {%- when 'chat' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5 5.3 16A8 8 0 1 1 8 18.7z"/><path d="M9 10.5c.5 1.6 1.9 3 3.5 3.5l1.2-1.1 1.8.8-.4 1.5c-3.2.2-6.7-3.3-6.5-6.5l1.5-.4.8 1.8z"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6z"/><path d="m9 12 2 2 4-4"/></svg>
            {%- endcase -%}
          </span>
          <div>
            <p class="trust-bar__title">{{ block.settings.title | escape }}</p>
            {%- if block.settings.text != blank -%}
              <p class="trust-bar__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Trust bar",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Promise",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "cash", "label": "Cash" },
            { "value": "return", "label": "Return" },
            { "value": "chat", "label": "Chat" },
            { "value": "shield", "label": "Shield" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Envío gratis"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "title": "Envío gratis" } },
        { "type": "item", "settings": { "icon": "cash", "title": "Pagas al recibir" } },
        { "type": "item", "settings": { "icon": "return", "title": "30 días para devolver" } },
        { "type": "item", "settings": { "icon": "chat", "title": "Te atendemos por WhatsApp" } }
      ]
    }
  ]
}
{% endschema %}
