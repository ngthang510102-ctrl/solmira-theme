{%- comment -%}
  Long-form sales images for ad traffic: stacks the product's own images from a given position
  onwards (infographics), full width on mobile like a landing page, with a buy button after them.
  Optionally hides those images from the main product gallery so it only shows product photos.
{%- endcomment -%}
{%- if product -%}
  {%- liquid
    assign start = section.settings.start_position
    assign long_media = product.media | where: 'media_type', 'image'
  -%}
  {%- style -%}
    .long-images-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
    @media screen and (min-width: 750px) {
      .long-images-{{ section.id }} {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
    .long-images {
      max-width: 60rem;
      margin: 0 auto;
    }
    .long-images__heading {
      text-align: center;
      margin: 0 1.5rem 2rem;
    }
    .long-images img {
      display: block;
      width: 100%;
      height: auto;
    }
    .long-images__cta {
      padding: 2rem 1.5rem 0;
    }
    .long-images__cta .button {
      width: 100%;
      min-height: 5.6rem;
      font-size: 1.7rem;
      font-weight: 700;
      letter-spacing: 0.06rem;
    }

    {%- if section.settings.hide_in_gallery -%}
      {%- for media in long_media -%}
        {%- if media.position >= start -%}
          media-gallery [data-media-id$='-{{ media.id }}'],
          media-gallery [data-target$='-{{ media.id }}'] {
            display: none;
          }
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endstyle -%}

  <div class="long-images-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
    <div class="long-images">
      {%- if section.settings.heading != blank -%}
        <h2 class="long-images__heading h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- for media in long_media -%}
        {%- if media.position >= start -%}
          {{
            media
            | image_url: width: 1080
            | image_tag:
              loading: 'lazy',
              widths: '375, 550, 750, 1080',
              sizes: '(min-width: 750px) 600px, 100vw',
              alt: media.alt
          }}
        {%- endif -%}
      {%- endfor -%}

      {%- if section.settings.button_label != blank -%}
        <div class="long-images__cta">
          <button type="button" class="button button--primary" data-long-images-buy>
            {{ section.settings.button_label | escape }}
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>

  <script>
    document.querySelectorAll('[data-long-images-buy]').forEach((button) => {
      button.addEventListener('click', () => {
        const codButton = document.getElementById('cod-open');
        if (codButton && !codButton.disabled) {
          codButton.click();
        } else {
          (codButton || document.querySelector('product-info')).scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Long product images",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "start_position",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 5,
      "label": "Show product images from position",
      "info": "Images before this position stay in the gallery only."
    },
    {
      "type": "checkbox",
      "id": "hide_in_gallery",
      "default": true,
      "label": "Hide these images from the product gallery"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "COMPRAR AHORA · Pago al recibir",
      "label": "Button label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Long product images"
    }
  ]
}
{% endschema %}
