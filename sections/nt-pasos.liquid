{%- comment -%}
  "Cómo hacer tu pedido" kiểu mới cho template product.win-win (theme win win).
  4 bước (block "Paso"), mỗi bước: icon, tiêu đề, mô tả, nhãn nhỏ. Có nút cuộn lên nút mua.
  Màu Noel đồng bộ khối đánh giá: đỏ #b8232f, xanh thông #1d5c3a, vàng #d9a23b.
{%- endcomment -%}
{%- assign sid = 'ntp-' | append: section.id -%}
<style>
  #{{ sid }} { --red: #b8232f; --green: #1d5c3a; --green-d: #0f3a24; --gold: #d9a23b; --cream: #fffaf3; --ink: #1f2a24; --muted: #5f6b63; --line: #ecdcc8; }
  #{{ sid }} .ntp { position: relative; padding: 36px 16px 32px; border: 1px solid var(--line); border-radius: 22px; overflow: hidden;
    background: radial-gradient(circle at 0% 0%, rgba(184,35,47,.08) 0, transparent 40%), radial-gradient(circle at 100% 100%, rgba(29,92,58,.10) 0, transparent 45%), var(--cream); }
  #{{ sid }} .ntp__head { max-width: 640px; margin: 0 auto 28px; text-align: center; }
  #{{ sid }} .ntp__eyebrow { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 12px; padding: 6px 14px; border-radius: 99px; background: var(--green); color: #fff; font-size: 11px; font-weight: 800; letter-spacing: 1.6px; text-transform: uppercase; }
  #{{ sid }} .ntp__eyebrow span { color: var(--gold); }
  #{{ sid }} .ntp__title { margin: 0 0 10px; color: var(--green-d); font-size: clamp(26px, 5vw, 38px); font-weight: 900; line-height: 1.12; letter-spacing: -.5px; }
  #{{ sid }} .ntp__title em { font-style: normal; color: var(--red); }
  #{{ sid }} .ntp__sub { margin: 0; color: var(--muted); font-size: 15px; line-height: 1.6; }

  #{{ sid }} .ntp__steps { position: relative; display: grid; grid-template-columns: 1fr; gap: 14px; margin: 0; padding: 0; list-style: none; counter-reset: ntp; }
  #{{ sid }} .ntp__step { position: relative; display: grid; grid-template-columns: 56px 1fr; gap: 14px; align-items: start; padding: 16px; background: #fff; border: 1px solid var(--line); border-radius: 16px; box-shadow: 0 10px 24px -14px rgba(15,58,36,.25); counter-increment: ntp; }
  #{{ sid }} .ntp__icon { position: relative; display: flex; align-items: center; justify-content: center; width: 56px; height: 56px; border-radius: 50%; background: linear-gradient(145deg, var(--green), var(--green-d)); color: #fff; box-shadow: 0 6px 14px rgba(15,58,36,.28); }
  #{{ sid }} .ntp__step:nth-child(even) .ntp__icon { background: linear-gradient(145deg, #d0333f, var(--red)); box-shadow: 0 6px 14px rgba(184,35,47,.28); }
  #{{ sid }} .ntp__icon svg { width: 26px; height: 26px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  #{{ sid }} .ntp__icon::after { content: counter(ntp); position: absolute; top: -4px; right: -4px; display: flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; background: var(--gold); color: var(--green-d); border: 2px solid #fff; font-size: 11px; font-weight: 900; }
  #{{ sid }} .ntp__body h3 { margin: 2px 0 4px; color: var(--green-d); font-size: 17px; font-weight: 800; line-height: 1.3; }
  #{{ sid }} .ntp__body p { margin: 0 0 8px; color: #4a5650; font-size: 14px; line-height: 1.55; }
  #{{ sid }} .ntp__tag { white-space: nowrap; display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 99px; background: #e7f2ea; color: var(--green); font-size: 11.5px; font-weight: 800; }
  #{{ sid }} .ntp__step:nth-child(even) .ntp__tag { background: #fbe9ea; color: var(--red); }
  #{{ sid }} .ntp__tag::before { content: "✓"; font-weight: 900; }

  /* Đường nối các bước: dọc trên điện thoại */
  #{{ sid }} .ntp__steps::before { content: ""; position: absolute; top: 40px; bottom: 40px; left: 43px; width: 2px; background: repeating-linear-gradient(to bottom, var(--red) 0 6px, transparent 6px 12px); opacity: .45; }
  #{{ sid }} .ntp__step { z-index: 1; }

  #{{ sid }} .ntp__cta { display: flex; flex-direction: column; align-items: center; gap: 8px; margin-top: 26px; }
  #{{ sid }} .ntp__btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 52px; padding: 0 30px; border: 0; border-radius: 8px; background: var(--red); color: #fff; font: inherit; font-size: 16px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; cursor: pointer; box-shadow: 0 8px 18px rgba(184,35,47,.32); transition: transform .15s ease, background .2s ease; }
  #{{ sid }} .ntp__btn:hover { background: #961e17; transform: translateY(-1px); }
  #{{ sid }} .ntp__btn svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  #{{ sid }} .ntp__note { margin: 0; color: var(--muted); font-size: 12.5px; }

  @media (min-width: 990px) {
    #{{ sid }} .ntp { padding: 52px 40px 44px; }
    #{{ sid }} .ntp__steps { grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, minmax(0, 1fr)); gap: 20px; }
    #{{ sid }} .ntp__steps::before { top: 44px; bottom: auto; left: 12%; right: 12%; width: auto; height: 2px; background: repeating-linear-gradient(to right, var(--red) 0 8px, transparent 8px 16px); }
    #{{ sid }} .ntp__step { display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 0; text-align: center; background: transparent; border: 0; box-shadow: none; }
    #{{ sid }} .ntp__icon { width: 64px; height: 64px; box-shadow: 0 0 0 8px var(--cream), 0 8px 18px rgba(15,58,36,.28); }
    #{{ sid }} .ntp__icon svg { width: 30px; height: 30px; }
    #{{ sid }} .ntp__body { padding: 16px 14px 18px; background: #fff; border: 1px solid var(--line); border-radius: 16px; box-shadow: 0 10px 24px -14px rgba(15,58,36,.25); width: 100%; flex: 1; }
  }
  @media (prefers-reduced-motion: reduce) { #{{ sid }} .ntp__btn { transition: none; } }
</style>

<div id="{{ sid }}">
  <div class="page-width">
    <div class="ntp">
      <div class="ntp__head">
        {%- if section.settings.eyebrow != blank -%}<p class="ntp__eyebrow"><span>✦</span> {{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="ntp__title">{{ section.settings.heading | escape }}{% if section.settings.heading_mark != blank %} <em>{{ section.settings.heading_mark | escape }}</em>{% endif %}</h2>
        {%- if section.settings.subheading != blank -%}<p class="ntp__sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
      </div>

      <ol class="ntp__steps">
        {%- for block in section.blocks -%}
          <li class="ntp__step" {{ block.shopify_attributes }}>
            <span class="ntp__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'form' -%}<svg viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h3"/></svg>
                {%- when 'chat' -%}<svg viewBox="0 0 24 24"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/></svg>
                {%- when 'truck' -%}<svg viewBox="0 0 24 24"><path d="M2 7h11v9H2z"/><path d="M13 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.7"/><circle cx="17" cy="17.5" r="1.7"/></svg>
                {%- when 'cash' -%}<svg viewBox="0 0 24 24"><rect x="2.5" y="6" width="19" height="12" rx="2"/><circle cx="12" cy="12" r="2.6"/><path d="M6 9.5v5M18 9.5v5"/></svg>
                {%- when 'box' -%}<svg viewBox="0 0 24 24"><path d="M3 7l9-4 9 4v10l-9 4-9-4V7z"/><path d="M3 7l9 4 9-4M12 11v10"/></svg>
                {%- else -%}<svg viewBox="0 0 24 24"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M1.5 2.5h3l2.6 12.4a2 2 0 0 0 2 1.6h8.7a2 2 0 0 0 2-1.6L21.5 7H6"/></svg>
              {%- endcase -%}
            </span>
            <div class="ntp__body">
              <h3>{{ block.settings.title | escape }}</h3>
              {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
              {%- if block.settings.tag != blank -%}<span class="ntp__tag">{{ block.settings.tag | escape }}</span>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>

      {%- if section.settings.button_label != blank -%}
        <div class="ntp__cta">
          <button type="button" class="ntp__btn" data-ntp-buy>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M1.5 2.5h3l2.6 12.4a2 2 0 0 0 2 1.6h8.7a2 2 0 0 0 2-1.6L21.5 7H6"/></svg>
            {{ section.settings.button_label | escape }}
          </button>
          {%- if section.settings.button_note != blank -%}<p class="ntp__note">{{ section.settings.button_note | escape }}</p>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('{{ sid }}');
    if (!root) return;
    var btn = root.querySelector('[data-ntp-buy]');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var target = document.getElementById('cod-open') || document.querySelector('variant-selects') || document.querySelector('.product__info-wrapper');
      if (!target) return;
      target.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  })();
</script>

{% schema %}
{
  "name": "Cómo hacer pedido",
  "tag": "section",
  "class": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Nhãn trên cùng", "default": "Así de fácil"},
    {"type": "text", "id": "heading", "label": "Tiêu đề", "default": "Cómo hacer tu pedido"},
    {"type": "text", "id": "heading_mark", "label": "Chữ đỏ cuối tiêu đề", "default": "en 4 pasos"},
    {"type": "text", "id": "subheading", "label": "Câu phụ", "default": "Sin tarjeta y sin pagar nada por adelantado."},
    {"type": "text", "id": "button_label", "label": "Chữ trên nút (để trống = ẩn nút)", "default": "Hacer mi pedido"},
    {"type": "text", "id": "button_note", "label": "Dòng nhỏ dưới nút", "default": "Pago contra reembolso · Envío gratis"}
  ],
  "blocks": [
    {
      "type": "paso",
      "name": "Paso",
      "limit": 5,
      "settings": [
        {"type": "select", "id": "icon", "label": "Icon", "default": "cart", "options": [
          {"value": "cart", "label": "Giỏ hàng"},
          {"value": "form", "label": "Phiếu điền"},
          {"value": "chat", "label": "Tin nhắn"},
          {"value": "truck", "label": "Xe giao hàng"},
          {"value": "cash", "label": "Tiền mặt"},
          {"value": "box", "label": "Hộp hàng"}
        ]},
        {"type": "text", "id": "title", "label": "Tiêu đề bước", "default": "Paso"},
        {"type": "textarea", "id": "text", "label": "Mô tả"},
        {"type": "text", "id": "tag", "label": "Nhãn nhỏ (để trống = ẩn)"}
      ]
    }
  ],
  "presets": [{"name": "Cómo hacer pedido"}]
}
{% endschema %}
