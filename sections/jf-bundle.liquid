{%- comment -%}
  Combos "Individual / Dúo" para la landing de cajas de almacenaje (template product.landing-storage-bags).
  No pinta nada por sí sola: carga assets/jf-bundle.js, que construye el selector dentro de la caja de compra
  de jf-landing y oculta su selector de packs normal. También pone la galería en formato 2:3 (todas las fotos
  del producto son 1024 x 1536).

  Variantes del producto (una sola opción, "Cantidad"):
    2 uds · 4 uds · Dúo: 2 uds + 2 uds · Dúo: 2 uds + 4 uds · Dúo: 4 uds + 4 uds
  Cada combinación es una variante con su precio, así el formulario COD (que lee ?variant=) y el servidor
  siguen igual. Los SKU no deben contener la letra x.
{%- endcomment -%}
<style>
  .jf-packs, .jf-packs__h { display: none !important; }

  /* Galería en 2:3: la foto se ve entera, sin recortes (PC y móvil) */
  .jf .jf-gal__slide { aspect-ratio: 2 / 3 !important; height: auto !important; }
  .jf .jf-gal__slide img { width: 100% !important; height: 100% !important; object-fit: contain !important; }
  .jf .jf-gal__thumb { flex: 0 0 56px !important; }
  .jf .jf-gal__thumb img { aspect-ratio: 2 / 3 !important; object-fit: contain !important; }

  .jfb { margin: 14px 0 6px; }
  .jfb__h { display: flex; align-items: center; gap: 10px; margin: 0 0 12px; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .jfb__h::before, .jfb__h::after { content: ""; flex: 1; height: 1px; background: #d4d4d4; }
  .jfb__card { position: relative; margin: 0 0 12px; padding: 14px 16px; border: 1px solid #d9d9d9; border-radius: 12px; background: #f2f2f2; cursor: pointer; }
  .jfb__card.is-on { padding: 13px 15px; border: 2px solid #111; background: #fff; }
  .jfb__card:focus-visible { outline: 2px solid var(--jf-accent, #b3171f); outline-offset: 2px; }
  .jfb__row { display: flex; align-items: center; gap: 12px; }
  .jfb__radio { flex: none; position: relative; width: 20px; height: 20px; border: 2px solid #111; border-radius: 50%; background: #fff; }
  .jfb__card.is-on .jfb__radio::after { content: ""; position: absolute; inset: 3px; border-radius: 50%; background: #111; }
  .jfb__tx { min-width: 0; }
  .jfb__name { display: block; font-family: var(--jf-font-title, inherit); font-size: 19px; font-weight: 800; line-height: 1.15; }
  .jfb__sub { display: block; margin-top: 2px; font-size: 13px; opacity: .75; }
  .jfb__save { display: inline-block; margin-left: 8px; padding: 2px 8px; border-radius: 6px; background: #e3e3e3; font-size: 11.5px; font-style: normal; font-weight: 700; letter-spacing: .02em; vertical-align: middle; }
  .jfb__save[hidden] { display: none; }
  .jfb__price { margin-left: auto; text-align: right; font-family: var(--jf-font-title, inherit); font-size: 20px; font-weight: 800; line-height: 1.1; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .jfb__price s { display: block; margin-top: 3px; font-size: 13px; font-weight: 500; opacity: .55; }
  .jfb__badge { position: absolute; top: -12px; right: 14px; padding: 3px 12px; border-radius: 999px; background: var(--jf-accent, #b3171f); color: #fff; font-size: 12px; font-weight: 700; transform: rotate(3deg); }
  .jfb__opts { display: none; margin-top: 12px; }
  .jfb__card.is-on .jfb__opts { display: block; }
  .jfb__optl { margin-bottom: 8px; font-size: 13px; font-weight: 600; }
  .jfb__opt { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .jfb__opt img { width: 40px; height: 60px; flex: none; object-fit: contain; border: 1px solid #e0e0e0; border-radius: 6px; background: #fff; }
  .jfb__opt span { min-width: 48px; font-size: 13px; }
  .jfb__sel { height: 38px; padding: 0 10px; border: 1px solid #b9b9b9; border-radius: 8px; background: #fff; color: inherit; font: inherit; font-size: 14px; }
  .jfb__tot { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 4px 2px 0; font-size: 14px; }
  .jfb__tot b { font-family: var(--jf-font-title, inherit); font-size: 22px; font-variant-numeric: tabular-nums; }
  .jfb__hint { margin: 6px 2px 0; font-size: 12.5px; opacity: .75; }
  .jfb__hint[hidden] { display: none; }
  .jfb-codnote { margin: 10px 0 0; padding: 10px 12px; border-radius: 8px; background: #eef6ff; color: #0b3a66; font-size: 13px; line-height: 1.45; }
  .cod-summary img[data-summary-image] { width: 6rem; height: 9rem; object-fit: contain; }
</style>

<script type="application/json" data-jf-bundle>
  {
    "cfg": {
      "heading": {{ section.settings.heading | json }},
      "single_name": {{ section.settings.single_name | json }},
      "single_sub": {{ section.settings.single_sub | json }},
      "duo_name": {{ section.settings.duo_name | json }},
      "duo_badge": {{ section.settings.duo_badge | json }},
      "save_word": {{ section.settings.save_word | json }},
      "saved_pct": {{ section.settings.saved_pct | json }},
      "qty_label": {{ section.settings.qty_label | json }},
      "pack_label": {{ section.settings.pack_label | json }},
      "unit": {{ section.settings.unit | json }},
      "total_label": {{ section.settings.total_label | json }},
      "duo_hint": {{ section.settings.duo_hint | json }},
      "cod_note": {{ section.settings.cod_note | json }},
      "badge_label": {{ section.settings.badge_label | json }},
      "default_combo": {{ section.settings.default_combo | json }},
      "img_single": {{ section.settings.img_single | default: 0 | json }},
      "img_duo": {{ section.settings.img_duo | default: 0 | json }}
    },
    "variants": [
      {%- for v in product.variants -%}
        {
          "id": {{ v.id }},
          "title": {{ v.option1 | json }},
          "price": {{ v.price }},
          "compare": {{ v.compare_at_price | default: 0 }},
          "available": {{ v.available | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
<script src="{{ 'jf-bundle.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Combos Individual / Dúo",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "paragraph", "content": "Selector de combos dentro de la caja de compra. Cần các biến thể: 2 uds, 4 uds, Dúo: 2 uds + 2 uds, Dúo: 2 uds + 4 uds, Dúo: 4 uds + 4 uds (SKU không chứa chữ x). Section này cũng đặt gallery ảnh sản phẩm về tỉ lệ 2:3." },
    { "type": "select", "id": "default_combo", "label": "Combo chọn sẵn khi mở trang", "default": "duo", "options": [
      { "value": "single", "label": "Individual" },
      { "value": "duo", "label": "Dúo" }
    ] },
    { "type": "number", "id": "img_single", "label": "Ảnh gallery khi chọn Individual (số thứ tự)", "default": 0, "info": "0 = tự động: ảnh pack 2 (gần cuối), đổi sang ảnh pack 4 nếu chọn 4 uds" },
    { "type": "number", "id": "img_duo", "label": "Ảnh gallery khi chọn Dúo (số thứ tự)", "default": 0, "info": "0 = tự động: ảnh cuối cùng (pack 4)" },

    { "type": "header", "content": "Textos" },
    { "type": "text", "id": "heading", "label": "Tiêu đề khối", "default": "Elige tu pack y ahorra" },
    { "type": "text", "id": "single_name", "label": "Tên combo 1", "default": "Individual" },
    { "type": "text", "id": "single_sub", "label": "Dòng phụ combo 1", "default": "Precio estándar" },
    { "type": "text", "id": "duo_name", "label": "Tên combo 2", "default": "Dúo" },
    { "type": "text", "id": "duo_badge", "label": "Nhãn nổi bật combo 2", "default": "Más popular" },
    { "type": "text", "id": "save_word", "label": "Chữ trên nhãn tiết kiệm (€)", "default": "AHORRA" },
    { "type": "text", "id": "saved_pct", "label": "Dòng % tiết kiệm", "default": "Ahorras un [pct] %", "info": "[pct] = phần trăm" },
    { "type": "text", "id": "badge_label", "label": "Chữ trên nhãn giảm giá ở giá chính", "default": "AHORRA" },
    { "type": "text", "id": "qty_label", "label": "Nhãn chọn số lượng", "default": "Cantidad" },
    { "type": "text", "id": "pack_label", "label": "Nhãn pack", "default": "Pack" },
    { "type": "text", "id": "unit", "label": "Đơn vị", "default": "uds" },
    { "type": "text", "id": "total_label", "label": "Nhãn tổng tiền", "default": "Total ([n] unidades)", "info": "[n] = tổng số cái" },
    { "type": "textarea", "id": "duo_hint", "label": "Ghi chú dưới tổng tiền (chỉ khi chọn Dúo)", "default": "En el Dúo eliges 2 o 4 unidades en cada pack: 4, 6 u 8 unidades en total." },
    { "type": "textarea", "id": "cod_note", "label": "Ghi chú trong form đặt hàng", "default": "Tu pedido: [desc] → [n] unidades en total. El total a pagar es la suma de los packs elegidos.", "info": "[desc] = combo đã chọn, [n] = tổng số cái" }
  ]
}
{% endschema %}